<Window
    x:Class="ModernFormatConverter.Views.Windows.PhotoConversionOutputConfigurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ModernFormatConverter.Views.Controls"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:settingsservice="using:ModernFormatConverter.Services.Settings"
    xmlns:system="using:System"
    Title="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Title')}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}"
    mc:Ignorable="d">

    <Page
        x:Name="PhotoConversionOutputConfigurationPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind settingsservice:LanguageService.FlowDirection}"
        Loaded="{x:Bind OnLoaded}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  图片格式转换配置标题栏  -->
            <TitleBar
                x:Name="AppTitlebar"
                Title="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Title')}"
                Grid.Row="0"
                Height="30"
                Padding="0"
                VerticalAlignment="Top">

                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarExpandedHeight">30</x:Double>
                </TitleBar.Resources>

                <TitleBar.LeftHeader>
                    <ImageIcon
                        Grid.Column="1"
                        MaxWidth="16"
                        MaxHeight="16"
                        Margin="10,0,-4,0"
                        Source="ms-appx:///Assets/ControlIcon/Settings.png" />
                </TitleBar.LeftHeader>
            </TitleBar>

            <!--  图片输出配置控件  -->
            <Grid Grid.Row="1" Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsCroppingImage), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image
                    Grid.Column="0"
                    ImageFailed="{x:Bind OnImageFailed}"
                    ImageOpened="{x:Bind OnImageOpened}"
                    Source="{x:Bind ImageSource, Mode=OneWay}"
                    Visibility="{x:Bind GetCutPhotoKind(CutPhotoResultKind, enum:CutPhotoResultKind.Successfully), Mode=OneWay}" />

                <ProgressRing
                    Grid.Column="0"
                    Width="80"
                    Height="80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind x:Object.Equals(CutPhotoResultKind, enum:CutPhotoResultKind.Loading), Mode=OneWay}"
                    Visibility="{x:Bind GetCutPhotoKind(CutPhotoResultKind, enum:CutPhotoResultKind.Loading), Mode=OneWay}" />

                <!--  图片播放失败  -->
                <Grid
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RowSpacing="10"
                    Visibility="{x:Bind GetCutPhotoKind(CutPhotoResultKind, enum:CutPhotoResultKind.Failed), Mode=OneWay}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="50,0,50,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('PhotoLoadFailed')}"
                        TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" HorizontalAlignment="Center">
                        <Run Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ErrorReason')}" />
                        <Run Text="{x:Bind ErrorReason, Mode=OneWay}" />
                    </TextBlock>

                    <Button
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        Click="{x:Bind OnOpenWithSystemPhotoClicked}"
                        Content="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('OpenWithSystemPhoto')}" />
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  图片格式转换配置控制栏  -->
                    <Grid Grid.Row="0" Margin="6,0,6,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <SelectorBar
                            x:Name="PhotoConversionOutputConfigurationSelectorBar"
                            Grid.Column="0"
                            Margin="-8,-4,0,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            SelectedItem="{x:Bind SelectedItem, Mode=OneWay}">

                            <SelectorBarItem Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Photo')}" />
                        </SelectorBar>

                        <CommandBar
                            Grid.Column="1"
                            Height="36"
                            Margin="0,0,-10,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            DefaultLabelPosition="Right">

                            <CommandBar.PrimaryCommands>
                                <AppBarButton
                                    Click="{x:Bind OnOkClicked}"
                                    Label="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('OK')}"
                                    Style="{StaticResource AppBarButtonStyle}">

                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8FB;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.PrimaryCommands>
                        </CommandBar>
                    </Grid>

                    <MenuFlyoutSeparator Grid.Row="1" Margin="6,0,6,3" />

                    <ScrollViewer
                        Grid.Row="2"
                        Padding="8,0,10,3"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">

                        <StackPanel Margin="0,0,0,30">
                            <TextBlock
                                x:Name="PhotoHeader"
                                Margin="2,0,0,5"
                                FontSize="16"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Photo')}" />

                            <!--  格式转换类型  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('FormatConversionType')}" />

                                <ComboBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="DisplayMember"
                                    ItemsSource="{x:Bind FormatConversionTypeList}"
                                    SelectedItem="{x:Bind SelectedFormatConversionType, Mode=OneWay}"
                                    SelectionChanged="{x:Bind OnFormatConversionTypeSelectionChanged}"
                                    Style="{StaticResource ComboBoxStyle}" />
                            </Grid>

                            <!--  图片选项  -->
                            <Expander
                                Margin="0,0,0,2"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                IsExpanded="True">

                                <Expander.Header>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('PhotoOptions')}" />
                                </Expander.Header>

                                <StackPanel Padding="0">
                                    <!--  裁剪图片  -->
                                    <Grid
                                        Height="52"
                                        Padding="16,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        ColumnSpacing="5">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('CutImage')}" />

                                        <ToggleSwitch
                                            Grid.Column="1"
                                            MinWidth="0"
                                            IsOn="{x:Bind IsImageCropped, Mode=OneWay}"
                                            OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('CutImageOffContent')}"
                                            OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('CutImageOnContent')}"
                                            Style="{StaticResource ToggleSwitchStyle}"
                                            Toggled="{x:Bind OnImageCroppedToggled}" />

                                        <Button
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Click="{x:Bind OnCutImageClicked}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">

                                            <FontIcon FontSize="16" Glyph="&#xE8C6;" />

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('CutImage')}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </Button>
                                    </Grid>

                                    <MenuFlyoutSeparator />

                                    <!--  图片大小  -->
                                    <Grid
                                        Height="52"
                                        Padding="16,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        ColumnSpacing="5"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageCropped), Mode=OneWay}">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('PhotoSize')}" />

                                        <NumberBox
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            ValueChanged="{x:Bind OnImageWidthValueChanged}"
                                            Value="{x:Bind ImageWidth, Mode=OneWay}" />

                                        <NumberBox
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            ValueChanged="{x:Bind OnImageHeightValueChanged}"
                                            Value="{x:Bind ImageHeight, Mode=OneWay}" />
                                    </Grid>

                                    <MenuFlyoutSeparator Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageCropped), Mode=OneWay}" />

                                    <!--  锁定比例  -->
                                    <Grid
                                        Height="52"
                                        Padding="16,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageCropped), Mode=OneWay}">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('LockRatio')}" />

                                        <ToggleSwitch
                                            Grid.Column="1"
                                            IsOn="{x:Bind LockRatio, Mode=OneWay}"
                                            OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('LockRatioOffContent')}"
                                            OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('LockRatioOnContent')}"
                                            Style="{StaticResource ToggleSwitchStyle}"
                                            Toggled="{x:Bind OnLockRatioToggled}" />
                                    </Grid>

                                    <!--  截取起点坐标  -->
                                    <Grid
                                        Height="52"
                                        Padding="16,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsImageCropped, Mode=OneWay}">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ClipStartPointPosition')}" />

                                        <Grid Grid.Column="1" ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('XCoordinate')}" />

                                            <NumberBox
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                ValueChanged="{x:Bind OnXCoordinateValueChanged}"
                                                Value="{x:Bind XCoordinate, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('YCoordinate')}" />

                                            <NumberBox
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind system:Convert.ToString(YCoordinate), Mode=OneWay}"
                                                ValueChanged="{x:Bind OnYCoordinateValueChanged}" />
                                        </Grid>
                                    </Grid>

                                    <MenuFlyoutSeparator Visibility="{x:Bind IsImageCropped, Mode=OneWay}" />

                                    <!--  截取大小  -->
                                    <Grid
                                        Height="52"
                                        Padding="16,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsImageCropped, Mode=OneWay}">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ClipSize')}" />

                                        <Grid Grid.Column="1" ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ClipWidth')}" />

                                            <NumberBox
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                ValueChanged="{x:Bind OnClipWidthValueChanged}"
                                                Value="{x:Bind ClipWidth, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ClipHeight')}" />

                                            <NumberBox
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                ValueChanged="{x:Bind OnClipHeightValueChanged}"
                                                Value="{x:Bind ClipHeight, Mode=OneWay}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!--  对比度  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="5"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ConstrastRatio')}" />

                                <Slider
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Maximum="1"
                                    Minimum="-1"
                                    SmallChange="0.1"
                                    StepFrequency="0.1"
                                    ValueChanged="{x:Bind OnConstrastRatioValueChanged}"
                                    Value="{x:Bind ConstrastRatio, Mode=OneWay}" />

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnResetConstrastRatioClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('Reset')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <!--  曝光  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="5"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Exposure')}" />

                                <Slider
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Maximum="2"
                                    Minimum="-2"
                                    SmallChange="0.01"
                                    StepFrequency="0.01"
                                    ValueChanged="{x:Bind OnExposureValueChanged}"
                                    Value="{x:Bind Exposure, Mode=OneWay}" />

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnResetExposureClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('Reset')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <!--  饱和度  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="5"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Saturation')}" />

                                <Slider
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Maximum="2"
                                    Minimum="0"
                                    SmallChange="0.01"
                                    StepFrequency="0.01"
                                    ValueChanged="{x:Bind OnSaturationValueChanged}"
                                    Value="{x:Bind Saturation, Mode=OneWay}" />

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnResetSaturationClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('Reset')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <!--  色温  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="5"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ColorTemperature')}" />

                                <Slider
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Maximum="1"
                                    Minimum="-1"
                                    SmallChange="0.01"
                                    StepFrequency="0.01"
                                    ValueChanged="{x:Bind OnColorTemperatureValueChanged}"
                                    Value="{x:Bind ColorTemperature, Mode=OneWay}" />

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnResetColorTemperatureClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('Reset')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <!--  色调  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="5"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Tone')}" />

                                <Slider
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Maximum="1"
                                    Minimum="-1"
                                    SmallChange="0.01"
                                    StepFrequency="0.01"
                                    ValueChanged="{x:Bind OnToneValueChanged}"
                                    Value="{x:Bind Tone, Mode=OneWay}" />

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnResetToneClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('Reset')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <!--  模糊  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="5"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Blur')}" />

                                <Slider
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Maximum="1"
                                    Minimum="-1"
                                    SmallChange="0.01"
                                    StepFrequency="0.01"
                                    ValueChanged="{x:Bind OnBlurValueChanged}"
                                    Value="{x:Bind Blur, Mode=OneWay}" />

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnResetBlurClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('Reset')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <!--  灰度  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="5"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('GrayScale')}" />

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{x:Bind GrayScale, Mode=OneWay}"
                                    OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('GrayScaleOffContent')}"
                                    OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('GrayScaleOnContent')}"
                                    Style="{StaticResource ToggleSwitchStyle}"
                                    Toggled="{x:Bind OnGrayScaleToggled}" />
                            </Grid>

                            <!--  反相  -->
                            <Grid
                                Height="60"
                                Margin="0,0,0,2"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="5"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Reversal')}" />

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{x:Bind Reversal, Mode=OneWay}"
                                    OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ReversalOffContent')}"
                                    OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ReversalOnContent')}"
                                    Style="{StaticResource ToggleSwitchStyle}"
                                    Toggled="{x:Bind OnReversalToggled}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!--  裁剪图片控件  -->
            <Grid Grid.Row="1" Visibility="{x:Bind IsCroppingImage, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:ImageCropper
                    x:Name="PhotoConversionOutputConfigurationImageCropper"
                    Grid.Row="0"
                    CropSizeChanged="{x:Bind OnCropSizeChanged}" />

                <Grid
                    Grid.Row="1"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ColumnSpacing="5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0">
                        <Run Text="(" /><Run Text="{x:Bind ClipedXCoordinate, Mode=OneWay}" /><Run Text="," />
                        <Run Text="{x:Bind ClipedYCoordinate, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>

                    <TextBlock Grid.Column="1">
                        <Run Text="{x:Bind ClipedWidth, Mode=OneWay}" /><Run Text=" x " /><Run Text="{x:Bind ClipedHeight, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,5"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="5">

                    <ComboBox
                        VerticalAlignment="Center"
                        DisplayMemberPath="DisplayMember"
                        ItemsSource="{x:Bind AspectRatioList}"
                        SelectedItem="{x:Bind SelectedAspectRatio, Mode=OneWay}"
                        SelectionChanged="{x:Bind OnAspectRatioSelectionChanged}"
                        Style="{StaticResource ComboBoxStyle}" />

                    <Button
                        Click="{x:Bind OnImageClipOkClicked}"
                        Content="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('OK')}"
                        Style="{StaticResource AccentButtonStyle}" />

                    <Button Click="{x:Bind OnImageClipCancelClicked}" Content="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Cancel')}" />
                </StackPanel>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="BackgroundDefault">
                        <VisualState.Setters>
                            <Setter Target="PhotoConversionOutputConfigurationPage.Background" Value="{ThemeResource DefaultBackgroundColorBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="BackgroundTransparent">
                        <VisualState.Setters>
                            <Setter Target="PhotoConversionOutputConfigurationPage.Background" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Page>
</Window>
