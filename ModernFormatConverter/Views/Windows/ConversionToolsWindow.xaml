<Window
    x:Class="ModernFormatConverter.Views.Windows.ConversionToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:collection="using:System.Collections"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page="using:ModernFormatConverter.Views.Pages"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:window="using:ModernFormatConverter.Views.Windows"
    Title="{x:Bind WindowTitle, Mode=OneWay}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}"
    mc:Ignorable="d">

    <Page
        x:Name="ConversionToolsPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind ((FrameworkElement)window:MainWindow.Current.Content).FlowDirection, Mode=OneWay}"
        Loaded="{x:Bind OnLoaded}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <TransitionCollection x:Name="SuppressNavigationTransitionCollection">
                    <NavigationThemeTransition>
                        <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            <SuppressNavigationTransitionInfo />
                        </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    </NavigationThemeTransition>
                </TransitionCollection>

                <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
                <Thickness x:Key="BreadcrumbBarChevronPadding">8,0</Thickness>

                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TabView
                Grid.Row="0"
                Margin="0,0,180,0"
                CanReorderTabs="False"
                IsAddTabButtonVisible="False"
                SelectedIndex="{x:Bind SelectedIndex, Mode=OneWay}"
                SelectionChanged="{x:Bind OnSelectionChanged}">

                <TabView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighConstract">
                                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="SystemColorWindowColorBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TabView.Resources>

                <TabView.TabItems>
                    <TabViewItem
                        Height="36"
                        Header="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('VideoConversion')}"
                        IsClosable="False">

                        <TabViewItem.IconSource>
                            <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/ControlIcon/VideoConversion.png" />
                        </TabViewItem.IconSource>
                    </TabViewItem>

                    <TabViewItem
                        Height="36"
                        Header="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('AudioConversion')}"
                        IsClosable="False">

                        <TabViewItem.IconSource>
                            <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/ControlIcon/AudioConversion.png" />
                        </TabViewItem.IconSource>
                    </TabViewItem>

                    <TabViewItem
                        Height="36"
                        Header="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('PhotoConversion')}"
                        IsClosable="False">

                        <TabViewItem.IconSource>
                            <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/ControlIcon/PhotoConversion.png" />
                        </TabViewItem.IconSource>
                    </TabViewItem>

                    <TabViewItem
                        Height="36"
                        Header="{x:Bind rootservice:ResourceService.ConversionToolsResource.GetString('DocumentConversion')}"
                        IsClosable="False">

                        <TabViewItem.IconSource>
                            <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/ControlIcon/DocumentConversion.png" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </TabView.TabItems>
            </TabView>

            <Frame
                x:Name="ConversionToolsFrame"
                Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                NavigationFailed="{x:Bind OnNavigationFailed}">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="BackgroundDefault">
                        <VisualState.Setters>
                            <Setter Target="ConversionToolsPage.Background" Value="{ThemeResource DefaultBackgroundColorBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="BackgroundTransparent" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Page>
</Window>
