<Window
    x:Class="ModernFormatConverter.Views.Windows.VideoExportPictureOutputConfigurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:settingsservice="using:ModernFormatConverter.Services.Settings"
    Title="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Title')}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}"
    mc:Ignorable="d">

    <Page
        x:Name="VideoExportPictureOutputConfigurationPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind settingsservice:LanguageService.FlowDirection}"
        Loaded="{x:Bind OnLoaded}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  视频导出图片输出配置标题栏  -->
            <TitleBar
                x:Name="AppTitlebar"
                Title="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Title')}"
                Grid.Row="0"
                Height="30"
                Padding="0"
                VerticalAlignment="Top">

                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarExpandedHeight">30</x:Double>
                </TitleBar.Resources>

                <TitleBar.LeftHeader>
                    <ImageIcon
                        Grid.Column="1"
                        MaxWidth="16"
                        MaxHeight="16"
                        Margin="10,0,-4,0"
                        Source="ms-appx:///Assets/ControlIcon/Settings.png" />
                </TitleBar.LeftHeader>
            </TitleBar>

            <!--  视频导出图片输出配置控制栏  -->
            <Grid Grid.Row="1" Margin="6,0,6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <SelectorBar
                    x:Name="VideoExportPictureOutputConfigurationSelectorBar"
                    Grid.Column="0"
                    Margin="-8,-4,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SelectedItem="{x:Bind SelectedItem, Mode=OneWay}">

                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('OutputConfiguration')}" />
                </SelectorBar>

                <CommandBar
                    Grid.Column="1"
                    Height="36"
                    Margin="0,0,-10,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    DefaultLabelPosition="Right">

                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            Click="{x:Bind OnOkClicked}"
                            Label="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('OK')}"
                            Style="{StaticResource AppBarButtonStyle}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8FB;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>

            <MenuFlyoutSeparator Grid.Row="2" Margin="6,0,6,3" />

            <ScrollViewer
                x:Name="VideoExportPictureOutputConfigurationScroll"
                Grid.Row="3"
                Padding="8,0,10,3"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">

                <StackPanel>
                    <!--  保存图片格式  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('SavePictureFormat')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="DisplayMember"
                            ItemsSource="{x:Bind SavePictureFormatList}"
                            SelectedItem="{x:Bind SelectedSavePictureFormat, Mode=OneWay}"
                            SelectionChanged="{x:Bind OnSelectedSavePictureFormatSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  视频导出图片方式  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('VideoExportPictureKind')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="DisplayMember"
                            ItemsSource="{x:Bind VideoExportPictureKindList}"
                            SelectedItem="{x:Bind SelectedVideoExportPictureKind, Mode=OneWay}"
                            SelectionChanged="{x:Bind OnSelectedVideoExportPictureKindSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  导出时间  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind GetSelectedVideoExportPictureKind(SelectedVideoExportPictureKind.SelectedValue, VideoExportPictureKindList[0].SelectedValue), Mode=OneWay}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('ExportTime')}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Hours')}" />

                        <NumberBox
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeHoursValueChanged}"
                            Value="{x:Bind TimeHours, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="3"
                            Margin="5,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Minutes')}" />

                        <NumberBox
                            Grid.Column="4"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeMinutesValueChanged}"
                            Value="{x:Bind TimeMinutes, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="5"
                            Margin="5,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Seconds')}" />

                        <NumberBox
                            Grid.Column="6"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeSecondsValueChanged}"
                            Value="{x:Bind TimeSeconds, Mode=OneWay}" />
                    </Grid>

                    <!--  导出起始时间  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind GetSelectedVideoExportPictureKind(SelectedVideoExportPictureKind.SelectedValue, VideoExportPictureKindList[1].SelectedValue), Mode=OneWay}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('ExportStartTime')}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Hours')}" />

                        <NumberBox
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeStartHoursValueChanged}"
                            Value="{x:Bind TimeStartHours, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="3"
                            Margin="5,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Minutes')}" />

                        <NumberBox
                            Grid.Column="4"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeStartMinutesValueChanged}"
                            Value="{x:Bind TimeStartMinutes, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="5"
                            Margin="5,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Seconds')}" />

                        <NumberBox
                            Grid.Column="6"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeStartSecondsValueChanged}"
                            Value="{x:Bind TimeStartSeconds, Mode=OneWay}" />
                    </Grid>

                    <!--  导出结束时间  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind GetSelectedVideoExportPictureKind(SelectedVideoExportPictureKind.SelectedValue, VideoExportPictureKindList[1].SelectedValue), Mode=OneWay}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('ExportEndTime')}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Hours')}" />

                        <NumberBox
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeEndHoursValueChanged}"
                            Value="{x:Bind TimeEndHours, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="3"
                            Margin="5,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Minutes')}" />

                        <NumberBox
                            Grid.Column="4"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeEndMinutesValueChanged}"
                            Value="{x:Bind TimeEndMinutes, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="5"
                            Margin="5,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('Seconds')}" />

                        <NumberBox
                            Grid.Column="6"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource NumberBoxStyle}"
                            ValueChanged="{x:Bind OnTimeEndSecondsValueChanged}"
                            Value="{x:Bind TimeEndSeconds, Mode=OneWay}" />
                    </Grid>

                    <!--  每秒导出图片数量  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoExportPictureOutputConfigurationResource.GetString('PictureExportPerSecond')}" />

                        <NumberBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="{x:Bind OnPictureExportPerSecondValueChanged}"
                            Value="{x:Bind PictureExportPerSecond, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="BackgroundDefault">
                        <VisualState.Setters>
                            <Setter Target="VideoExportPictureOutputConfigurationPage.Background" Value="{ThemeResource DefaultBackgroundColorBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="BackgroundTransparent">
                        <VisualState.Setters>
                            <Setter Target="VideoExportPictureOutputConfigurationPage.Background" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Page>
</Window>
