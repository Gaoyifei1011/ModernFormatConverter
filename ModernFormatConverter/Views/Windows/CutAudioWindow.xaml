<Window
    x:Class="ModernFormatConverter.Views.Windows.CutAudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:settingsservice="using:ModernFormatConverter.Services.Settings"
    Title="{x:Bind rootservice:ResourceService.LicenseResource.GetString('Title')}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}"
    mc:Ignorable="d">

    <Page
        x:Name="CutAudioPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind settingsservice:LanguageService.FlowDirection}"
        Loaded="{x:Bind OnLoaded}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />

                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  剪辑音频标题栏  -->
            <TitleBar
                x:Name="AppTitlebar"
                Title="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Title')}"
                Grid.Row="0"
                Height="30"
                Padding="0"
                VerticalAlignment="Top">

                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarExpandedHeight">30</x:Double>
                </TitleBar.Resources>

                <TitleBar.LeftHeader>
                    <ImageIcon
                        Grid.Column="1"
                        MaxWidth="16"
                        MaxHeight="16"
                        Margin="10,0,-4,0"
                        Source="ms-appx:///Assets/ControlIcon/CutAudio.png" />
                </TitleBar.LeftHeader>
            </TitleBar>

            <Grid Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="320" />
                    </Grid.RowDefinitions>

                    <ProgressRing
                        Grid.Row="0"
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind x:Object.Equals(CutAudioResultKind, enum:CutAudioResultKind.Loading), Mode=OneWay}"
                        Visibility="{x:Bind GetCutAudioKind(CutAudioResultKind, enum:CutAudioResultKind.Loading), Mode=OneWay}" />

                    <!--  音频播放组件  -->
                    <MediaPlayerElement
                        x:Name="CutAudioMediaPlayerElement"
                        Grid.Row="0"
                        AreTransportControlsEnabled="True"
                        AutoPlay="False"
                        Source="{x:Bind MediaSource, Mode=OneWay}"
                        Visibility="{x:Bind GetCutAudioKind(CutAudioResultKind, enum:CutAudioResultKind.Successfully), Mode=OneWay}">

                        <MediaPlayerElement.TransportControls>
                            <MediaTransportControls
                                IsCompact="False"
                                IsFastForwardButtonVisible="True"
                                IsFastForwardEnabled="True"
                                IsFastRewindButtonVisible="True"
                                IsFastRewindEnabled="True"
                                IsPlaybackRateButtonVisible="True"
                                IsPlaybackRateEnabled="True"
                                IsSeekBarVisible="True"
                                IsSeekEnabled="True"
                                IsSkipBackwardButtonVisible="True"
                                IsSkipBackwardEnabled="True"
                                IsSkipForwardButtonVisible="True"
                                IsSkipForwardEnabled="True"
                                IsStopButtonVisible="True"
                                IsStopEnabled="True"
                                IsVolumeButtonVisible="True"
                                IsVolumeEnabled="True"
                                IsZoomButtonVisible="True"
                                IsZoomEnabled="True"
                                Style="{StaticResource MediaTransportControlsStyle}"
                                Visibility="Visible" />
                        </MediaPlayerElement.TransportControls>
                    </MediaPlayerElement>

                    <Image
                        Grid.Row="0"
                        Width="200"
                        Height="200"
                        Margin="0,0,0,112"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{x:Bind AudioCoverImage, Mode=OneWay}"
                        Visibility="{x:Bind GetCutAudioKind(CutAudioResultKind, enum:CutAudioResultKind.Successfully), Mode=OneWay}" />

                    <!--  音频播放失败  -->
                    <Grid
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RowSpacing="10"
                        Visibility="{x:Bind GetCutAudioKind(CutAudioResultKind, enum:CutAudioResultKind.Failed), Mode=OneWay}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="50,0,50,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('AudioPlayFailed')}"
                            TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" HorizontalAlignment="Center">
                            <Run Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('ErrorReason')}" />
                            <Run Text="{x:Bind ErrorReason, Mode=OneWay}" />
                        </TextBlock>

                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Click="{x:Bind OnPlayWithSystemAudioClicked}"
                            Content="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('PlayWithSystemAudio')}" />
                    </Grid>

                    <!--  剪切音频选项  -->
                    <Grid
                        Grid.Row="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="FileNameText"
                                Grid.Column="0"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{x:Bind FileName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap">

                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        MaxWidth="9999"
                                        Padding="0"
                                        Background="Transparent"
                                        Visibility="{x:Bind FileNameText.IsTextTrimmed, Mode=OneWay}">

                                        <Grid>
                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind FileName, Mode=OneWay}" />
                                        </Grid>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </TextBlock>

                            <SelectorBar
                                x:Name="CutAudioSelectorBar"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind CutAudioSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnCutAudioSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Editing')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Cover')}" />
                            </SelectorBar>

                            <Button
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                Click="{x:Bind OnOkClicked}"
                                Content="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('OK')}" />
                        </Grid>

                        <!--  剪辑选项  -->
                        <Grid
                            Grid.Row="1"
                            Margin="10,5,10,10"
                            Visibility="{x:Bind GetCutAudioSelectedItem(CutAudioSelectedItem, CutAudioSelectorBar.Items[0]), Mode=OneWay}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  起始时间选项  -->
                            <Grid Grid.Column="0" RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="20"
                                    Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('StartTime')}" />

                                <ContentControl Grid.Row="1" HorizontalAlignment="Left">

                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Hours')}" />

                                        <NumberBox
                                            VerticalAlignment="Center"
                                            LargeChange="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Style="{StaticResource NumberBoxStyle}"
                                            ValueChanged="{x:Bind OnTimeStartHoursValueChanged}"
                                            Value="{x:Bind TimeStartHours, Mode=OneWay}" />

                                        <TextBlock
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Minutes')}" />

                                        <NumberBox
                                            VerticalAlignment="Center"
                                            LargeChange="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Style="{StaticResource NumberBoxStyle}"
                                            ValueChanged="{x:Bind OnTimeStartMinutesValueChanged}"
                                            Value="{x:Bind TimeStartMinutes, Mode=OneWay}" />

                                        <TextBlock
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Seconds')}" />

                                        <NumberBox
                                            VerticalAlignment="Center"
                                            LargeChange="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Style="{StaticResource NumberBoxStyle}"
                                            ValueChanged="{x:Bind OnTimeStartSecondsValueChanged}"
                                            Value="{x:Bind TimeStartSeconds, Mode=OneWay}" />

                                        <NumberBox
                                            VerticalAlignment="Center"
                                            LargeChange="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Style="{StaticResource NumberBoxStyle}"
                                            ValueChanged="{x:Bind OnTimeStartMillsecondsValueChanged}"
                                            Value="{x:Bind TimeStartMillseconds, Mode=OneWay}" />

                                        <Button
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Click="{x:Bind OnTimeStartLocationClicked}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">

                                            <FontIcon FontSize="16" Glyph="&#xECAF;" />

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('TimeStartLocation')}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </Button>

                                        <Button
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Click="{x:Bind OnTimeStartLocateVdieoClicked}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">

                                            <FontIcon FontSize="16" Glyph="&#xE768;" />

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('LocateAudio')}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </ContentControl>
                            </Grid>

                            <AppBarSeparator Grid.Column="1" Margin="15,-8,15,-30" />

                            <!--  结束时间选项  -->
                            <Grid Grid.Column="2" RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="20"
                                    Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('EndTime')}" />

                                <StackPanel
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    Spacing="5">

                                    <TextBlock
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Hours')}" />

                                    <NumberBox
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeEndHoursValueChanged}"
                                        Value="{x:Bind TimeEndHours, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Minutes')}" />

                                    <NumberBox
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeEndMinutesValueChanged}"
                                        Value="{x:Bind TimeEndMinutes, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('Seconds')}" />

                                    <NumberBox
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeEndSecondsValueChanged}"
                                        Value="{x:Bind TimeEndSeconds, Mode=OneWay}" />

                                    <NumberBox
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeEndMillsecondsValueChanged}"
                                        Value="{x:Bind TimeEndMillseconds, Mode=OneWay}" />

                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="{x:Bind OnTimeEndLocationClicked}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">

                                        <FontIcon FontSize="16" Glyph="&#xECAF;" />

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('TimeEndLocation')}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>

                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="{x:Bind OnTimeEndLocateVdieoClicked}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">

                                        <FontIcon FontSize="16" Glyph="&#xE768;" />

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('LocateAudio')}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!--  封面选项  -->
                        <Grid
                            Grid.Row="1"
                            Margin="10,5,10,10"
                            RowSpacing="5"
                            Visibility="{x:Bind GetCutAudioSelectedItem(CutAudioSelectedItem, CutAudioSelectorBar.Items[1]), Mode=OneWay}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('SetAudioCover')}" />

                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    Click="{x:Bind OnSelectFileClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsLoadingAudioCover), Mode=OneWay}">

                                    <FontIcon FontSize="16" Glyph="&#xE838;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('SelectFile')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>

                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnClearSelectFileClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsLoadingAudioCover), Mode=OneWay}">

                                    <FontIcon FontSize="16" Glyph="&#xE894;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('ClearSelectFile')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock
                                    Text="{x:Bind rootservice:ResourceService.CutAudioResource.GetString('AudioCoverPositon')}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />

                                <TextBlock Visibility="{x:Bind GetAudioConverFilePathState(AudioCoverFilePath, x:False), Mode=OneWay}">
                                    <Hyperlink Click="{x:Bind OnAudioCoverFilePathClicked}" UnderlineStyle="None">
                                        <Run Text="{x:Bind AudioCoverFilePath, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Text="N/A" Visibility="{x:Bind GetAudioConverFilePathState(AudioCoverFilePath, x:True), Mode=OneWay}" />
                            </StackPanel>

                            <Grid
                                Grid.Row="2"
                                Width="400"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <ProgressRing
                                    Width="45"
                                    Height="45"
                                    Canvas.ZIndex="1"
                                    IsActive="{x:Bind IsLoadingAudioCover, Mode=OneWay}"
                                    Visibility="{x:Bind IsLoadingAudioCover, Mode=OneWay}" />

                                <Image Source="{x:Bind SelectedAudioCoverImage, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="BackgroundDefault">
                        <VisualState.Setters>
                            <Setter Target="CutAudioPage.Background" Value="{ThemeResource DefaultBackgroundColorBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="BackgroundTransparent">
                        <VisualState.Setters>
                            <Setter Target="CutAudioPage.Background" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Page>
</Window>
