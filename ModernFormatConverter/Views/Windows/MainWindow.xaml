<Window
    x:Class="ModernFormatConverter.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:settingsservice="using:ModernFormatConverter.Services.Settings"
    Title="{x:Bind WindowTitle, Mode=OneWay}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}">

    <Page
        x:Name="MainPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind settingsservice:LanguageService.FlowDirection}"
        KeyDown="{x:Bind OnKeyDown}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnRestoreClicked}"
                        FontSize="12"
                        IsEnabled="{x:Bind IsWindowMaximized, Mode=OneWay}"
                        Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsWindowMaximized), Mode=OneWay}"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsWindowMaximized), Mode=OneWay}"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMinimizeClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMaximizeClicked}"
                        FontSize="12"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsWindowMaximized), Mode=OneWay}"
                        Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <!--  应用标题栏内容  -->
            <TitleBar
                x:Name="AppTitlebar"
                Title="{x:Bind WindowTitle, Mode=OneWay}"
                Height="48"
                VerticalAlignment="Top">

                <TitleBar.LeftHeader>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Width="40"
                            Height="36"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource TitleBarBackButtonBackground}"
                            Click="{x:Bind OnBackClicked}"
                            IsEnabled="{x:Bind IsBackEnabled, Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}">

                            <AnimatedIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AnimatedIcon.State="Normal">
                                <animatedvisuals:AnimatedBackVisualSource />
                                <AnimatedIcon.FallbackIconSource>
                                    <FontIconSource
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        MirroredWhenRightToLeft="True" />
                                </AnimatedIcon.FallbackIconSource>
                            </AnimatedIcon>

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Back')}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>
                </TitleBar.LeftHeader>
            </TitleBar>

            <NavigationView
                x:Name="MainNavigationView"
                Margin="0,40,0,0"
                AlwaysShowHeader="False"
                Canvas.ZIndex="0"
                Collapsed="{x:Bind OnCollapsed}"
                Expanding="{x:Bind OnExpanding}"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                ItemInvoked="{x:Bind OnItemInvoked}"
                Loaded="{x:Bind OnLoaded}"
                OpenPaneLength="220"
                PaneDisplayMode="Left"
                SelectedItem="{x:Bind SelectedItem, Mode=OneWay}">

                <NavigationView.MenuItems>
                    <!--  主页  -->
                    <NavigationViewItem Tag="{x:Bind PageList[0].Key}">

                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/ControlIcon/Home.png" />
                        </NavigationViewItem.Icon>

                        <NavigationViewItem.Content>
                            <TextBlock
                                x:Name="WindowHomeText"
                                Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Home')}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </NavigationViewItem.Content>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{x:Bind WindowHomeText.IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Home')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </NavigationViewItem>

                    <!--  任务管理  -->
                    <NavigationViewItem Tag="{x:Bind PageList[1].Key}">

                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/ControlIcon/TaskManager.png" />
                        </NavigationViewItem.Icon>

                        <NavigationViewItem.Content>
                            <TextBlock
                                x:Name="WindowTaskManagerText"
                                Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('TaskManager')}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </NavigationViewItem.Content>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{x:Bind WindowTaskManagerText.IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('TaskManager')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </NavigationViewItem>

                    <!--  文件信息  -->
                    <NavigationViewItem Tag="{x:Bind PageList[2].Key}">

                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/ControlIcon/FileInformation.png" />
                        </NavigationViewItem.Icon>

                        <NavigationViewItem.Content>
                            <TextBlock
                                x:Name="WindowFileInformationText"
                                Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('FileInformation')}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </NavigationViewItem.Content>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{x:Bind WindowFileInformationText.IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('FileInformation')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </NavigationViewItem>

                    <!--  硬件加速测试  -->
                    <NavigationViewItem Tag="{x:Bind PageList[3].Key}">

                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/ControlIcon/HATest.png" />
                        </NavigationViewItem.Icon>

                        <NavigationViewItem.Content>
                            <TextBlock
                                x:Name="WindowHATestText"
                                Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('HATest')}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </NavigationViewItem.Content>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{x:Bind WindowHATestText.IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('HATest')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </NavigationViewItem>

                    <!--  硬件加速测试  -->
                    <NavigationViewItem Tag="{x:Bind PageList[4].Key}">

                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/ControlIcon/CustomCommand.png" />
                        </NavigationViewItem.Icon>

                        <NavigationViewItem.Content>
                            <TextBlock
                                x:Name="WindowCustomCommandText"
                                Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('CustomCommand')}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </NavigationViewItem.Content>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{x:Bind WindowCustomCommandText.IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('CustomCommand')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <!--  设置  -->
                    <NavigationViewItem Tag="{x:Bind PageList[5].Key}">

                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/ControlIcon/Settings.png" />
                        </NavigationViewItem.Icon>

                        <NavigationViewItem.Content>
                            <TextBlock
                                x:Name="WindowSettingsText"
                                Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Settings')}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </NavigationViewItem.Content>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{x:Bind WindowSettingsText.IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.WindowResource.GetString('Settings')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Frame
                    Margin="0,-10,0,0"
                    Navigated="{x:Bind OnNavigated}"
                    NavigationFailed="{x:Bind OnNavigationFailed}">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </NavigationView>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="BackgroundDefault">
                        <VisualState.Setters>
                            <Setter Target="MainPage.Background" Value="{ThemeResource DefaultBackgroundColorBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="BackgroundTransparent" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Page>
</Window>
