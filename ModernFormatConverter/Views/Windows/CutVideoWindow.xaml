<Window
    x:Class="ModernFormatConverter.Views.Windows.CutVideoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:settingsservice="using:ModernFormatConverter.Services.Settings"
    Title="{x:Bind rootservice:ResourceService.LicenseResource.GetString('Title')}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}"
    mc:Ignorable="d">

    <Page
        x:Name="CutVideoPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind settingsservice:LanguageService.FlowDirection}"
        Loaded="{x:Bind OnLoaded}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  剪辑视频标题栏  -->
            <TitleBar
                x:Name="AppTitlebar"
                Title="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Title')}"
                Grid.Row="0"
                Height="30"
                Padding="0"
                VerticalAlignment="Top">

                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarExpandedHeight">30</x:Double>
                </TitleBar.Resources>

                <TitleBar.LeftHeader>
                    <ImageIcon
                        Grid.Column="1"
                        MaxWidth="16"
                        MaxHeight="16"
                        Margin="10,0,-4,0"
                        Source="ms-appx:///Assets/ControlIcon/CutVideo.png" />
                </TitleBar.LeftHeader>
            </TitleBar>

            <Grid Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="320" />
                    </Grid.RowDefinitions>

                    <!--  视频播放组件  -->
                    <MediaPlayerElement
                        x:Name="CutVideoMediaPlayerElement"
                        Grid.Row="0"
                        AreTransportControlsEnabled="True"
                        AutoPlay="False"
                        Source="{x:Bind MediaSource, Mode=OneWay}"
                        Visibility="{x:Bind IsMediaPlayedSuccessfully, Mode=OneWay}">

                        <MediaPlayerElement.TransportControls>
                            <MediaTransportControls
                                IsCompact="False"
                                IsFastForwardButtonVisible="True"
                                IsFastForwardEnabled="True"
                                IsFastRewindButtonVisible="True"
                                IsFastRewindEnabled="True"
                                IsPlaybackRateButtonVisible="True"
                                IsPlaybackRateEnabled="True"
                                IsSeekBarVisible="True"
                                IsSeekEnabled="True"
                                IsSkipBackwardButtonVisible="True"
                                IsSkipBackwardEnabled="True"
                                IsSkipForwardButtonVisible="True"
                                IsSkipForwardEnabled="True"
                                IsStopButtonVisible="True"
                                IsStopEnabled="True"
                                IsVolumeButtonVisible="True"
                                IsVolumeEnabled="True"
                                IsZoomButtonVisible="True"
                                IsZoomEnabled="True"
                                Style="{StaticResource MediaTransportControlsStyle}" />
                        </MediaPlayerElement.TransportControls>
                    </MediaPlayerElement>

                    <!--  视频播放失败  -->
                    <Grid
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RowSpacing="10"
                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsMediaPlayedSuccessfully), Mode=OneWay}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="50,0,50,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('VideoPlayFailed')}"
                            TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" HorizontalAlignment="Center">
                            <Run Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('ErrorReason')}" />
                            <Run Text="{x:Bind ErrorReason, Mode=OneWay}" />
                        </TextBlock>

                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Click="{x:Bind OnPlayWithSystemVideoClicked}"
                            Content="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('PlayWithSystemVideo')}" />
                    </Grid>

                    <!--  剪切视频选项  -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <SelectorBar
                            x:Name="CutVideoSelectorBar"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            SelectedItem="{x:Bind CutVideoSelectedItem, Mode=OneWay}"
                            SelectionChanged="{x:Bind OnCutVideoSelectionChanged}">

                            <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Editing')}" />
                            <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('ImageCropping')}" />
                            <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Options')}" />
                        </SelectorBar>

                        <!--  剪辑选项  -->
                        <Grid
                            Grid.Row="1"
                            Margin="10,0,10,10"
                            Visibility="{x:Bind GetCutVideoSelectedItem(CutVideoSelectedItem, CutVideoSelectorBar.Items[0]), Mode=OneWay}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  起始时间选项  -->
                            <Grid Grid.Column="0" RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="20"
                                    Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('StartTime')}" />

                                <StackPanel
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">

                                    <TextBlock
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Hours')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeStartHoursValueChanged}"
                                        Value="{x:Bind TimeStartHours, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="5,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Minutes')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeStartMinutesValueChanged}"
                                        Value="{x:Bind TimeStartMinutes, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="5,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Seconds')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeStartSecondsValueChanged}"
                                        Value="{x:Bind TimeStartSeconds, Mode=OneWay}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeStartMillsecondsValueChanged}"
                                        Value="{x:Bind TimeStartMillseconds, Mode=OneWay}" />

                                    <Button
                                        Width="32"
                                        Height="32"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        Click="{x:Bind OnTimeStartLocationClicked}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">

                                        <FontIcon FontSize="16" Glyph="&#xECAF;" />

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('TimeStartLocation')}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>

                                    <Button
                                        Width="32"
                                        Height="32"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        Click="{x:Bind OnTimeStartLocateVdieoClicked}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">

                                        <FontIcon FontSize="16" Glyph="&#xE768;" />

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('LocateVideo')}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="2"
                                    FontSize="20"
                                    Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('StartTimeScreenshot')}" />

                                <Grid
                                    Grid.Row="3"
                                    Width="400"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <Image Source="{x:Bind TimeStartImage, Mode=OneWay}" />
                                </Grid>
                            </Grid>

                            <AppBarSeparator Grid.Column="1" Margin="15,0" />

                            <!--  结束时间选项  -->
                            <Grid Grid.Column="2" RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="20"
                                    Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('EndTime')}" />

                                <StackPanel
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">

                                    <TextBlock
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Hours')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeEndHoursValueChanged}"
                                        Value="{x:Bind TimeEndHours, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="5,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Minutes')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeEndMinutesValueChanged}"
                                        Value="{x:Bind TimeEndMinutes, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="5,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('Seconds')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeEndSecondsValueChanged}"
                                        Value="{x:Bind TimeEndSeconds, Mode=OneWay}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource NumberBoxStyle}"
                                        ValueChanged="{x:Bind OnTimeEndMillsecondsValueChanged}"
                                        Value="{x:Bind TimeEndMillseconds, Mode=OneWay}" />

                                    <Button
                                        Width="32"
                                        Height="32"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        Click="{x:Bind OnTimeEndLocationClicked}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">

                                        <FontIcon FontSize="16" Glyph="&#xECAF;" />

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('TimeEndLocation')}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>

                                    <Button
                                        Width="32"
                                        Height="32"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        Click="{x:Bind OnTimeEndLocateVdieoClicked}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">

                                        <FontIcon FontSize="16" Glyph="&#xE768;" />

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('LocateVideo')}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="2"
                                    FontSize="20"
                                    Text="{x:Bind rootservice:ResourceService.CutVideoResource.GetString('EndTimeScreenshot')}" />

                                <Grid
                                    Grid.Row="3"
                                    Width="400"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <Image Source="{x:Bind TimeEndImage, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="BackgroundDefault">
                        <VisualState.Setters>
                            <Setter Target="CutVideoPage.Background" Value="{ThemeResource DefaultBackgroundColorBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="BackgroundTransparent">
                        <VisualState.Setters>
                            <Setter Target="CutVideoPage.Background" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Page>
</Window>
