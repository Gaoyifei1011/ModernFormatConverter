<Window
    x:Class="ModernFormatConverter.Views.Dialogs.VideoFormatConversionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:class="using:ModernFormatConverter.Extensions.DataType.Class"
    xmlns:collection="using:System.Collections"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ModernFormatConverter.Models"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:system="using:System"
    xmlns:window="using:ModernFormatConverter.Views.Windows"
    Title="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Title')}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}"
    mc:Ignorable="d">

    <Page
        x:Name="VideoFormatConversionPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind ((FrameworkElement)window:MainWindow.Current.Content).FlowDirection, Mode=OneWay}"
        Loaded="{x:Bind OnLoaded}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>

                <class:ExecuteCommand x:Name="FormatConversionTypeCommand" ExecuteRequested="{x:Bind OnFormatConversionTypeExecuteRequested}" />
                <class:ExecuteCommand x:Name="SizeLimitationCommand" ExecuteRequested="{x:Bind OnSizeLimitationExecuteRequested}" />
                <class:ExecuteCommand x:Name="VideoEncodingCommand" ExecuteRequested="{x:Bind OnVideoEncodingExecuteRequested}" />
                <class:ExecuteCommand x:Name="ScreenSizeCommand" ExecuteRequested="{x:Bind OnScreenSizeExecuteRequested}" />
                <class:ExecuteCommand x:Name="VideoBitRateCommand" ExecuteRequested="{x:Bind OnVideoBitRateExecuteRequested}" />
                <class:ExecuteCommand x:Name="GPUCommand" ExecuteRequested="{x:Bind OnGPUExecuteRequested}" />
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  视频输出配置标题栏  -->
            <TitleBar
                x:Name="AppTitlebar"
                Title="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Title')}"
                Grid.Row="0"
                Height="30"
                Padding="0"
                VerticalAlignment="Top">

                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarExpandedHeight">30</x:Double>
                </TitleBar.Resources>

                <TitleBar.LeftHeader>
                    <ImageIcon
                        Grid.Column="1"
                        MaxWidth="16"
                        MaxHeight="16"
                        Margin="10,0,-4,0"
                        Source="ms-appx:///Assets/ControlIcon/Settings.png" />
                </TitleBar.LeftHeader>
            </TitleBar>

            <Grid Grid.Row="1" Margin="6,0,6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <SelectorBar
                    x:Name="VideoOutputConfigurationSelectorBar"
                    Grid.Column="0"
                    Margin="-8,-4,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SelectedItem="{x:Bind SelectedItem, Mode=OneWay}"
                    SelectionChanged="{x:Bind OnSelectorBarSelectionChanged}">

                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Video')}" />
                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Audio')}" />
                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Subtitle')}" />
                </SelectorBar>

                <CommandBar
                    Grid.Column="1"
                    Height="36"
                    Margin="0,0,-10,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    DefaultLabelPosition="Right">

                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            Click="{x:Bind OnSegmentationClicked}"
                            Label="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Segmentation')}"
                            Style="{StaticResource AppBarButtonStyle}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C6;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton
                            Click="{x:Bind OnOkClicked}"
                            Label="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('OK')}"
                            Style="{StaticResource AppBarButtonStyle}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8FB;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>

            <MenuFlyoutSeparator Grid.Row="2" Margin="6,0,6,3" />

            <ScrollViewer
                Grid.Row="3"
                Padding="8,0,10,3"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ViewChanged="{x:Bind OnViewChanged}">

                <StackPanel>
                    <TextBlock
                        x:Name="VideoHeader"
                        Margin="2,0,0,5"
                        FontSize="16"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Video')}" />

                    <!--  视频编辑  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('VideoEdit')}" />

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="{x:Bind OnVideoEditClicked}"
                            Content="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Edit')}" />
                    </Grid>

                    <!--  格式转换类型  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('FormatConversionType')}" />

                        <DropDownButton
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{x:Bind SelectedFormatConversionType.Value, Mode=OneWay}">

                            <DropDownButton.Flyout>
                                <Flyout
                                    x:Name="FormatConversionTypeFlyout"
                                    Opened="{x:Bind OnFormatConversionTypeOpened}"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="False">

                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource OverlayCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                        <ListView
                                            x:Name="FormatConversionTypeListView"
                                            MaxHeight="300"
                                            Background="Transparent"
                                            ItemsSource="{x:Bind FormatConversionTypeList}"
                                            SelectionMode="None">

                                            <ListView.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="MinHeight" Value="0 " />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ItemsControl.ItemContainerTransitions>
                                                <TransitionCollection />
                                            </ItemsControl.ItemContainerTransitions>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="model:KeyValuePairModel">
                                                    <RadioMenuFlyoutItem
                                                        Height="32"
                                                        Padding="11,0"
                                                        Command="{StaticResource FormatConversionTypeCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        GroupName="FormatConversionTypeRadioGroup"
                                                        IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                        Text="{x:Bind Value}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!--  大小限制  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SizeLimitation')}" />

                        <DropDownButton
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{x:Bind SelectedSizeLimitation.Value, Mode=OneWay}">

                            <DropDownButton.Flyout>
                                <Flyout
                                    x:Name="SizeLimitationFlyout"
                                    Opened="{x:Bind OnSizeLimitationOpened}"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="False">

                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource OverlayCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                        <ListView
                                            x:Name="SizeLimitationListView"
                                            MaxHeight="300"
                                            Background="Transparent"
                                            ItemsSource="{x:Bind SizeLimitationList}"
                                            SelectionMode="None">

                                            <ListView.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="MinHeight" Value="0 " />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ItemsControl.ItemContainerTransitions>
                                                <TransitionCollection />
                                            </ItemsControl.ItemContainerTransitions>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="model:KeyValuePairModel">
                                                    <RadioMenuFlyoutItem
                                                        Height="32"
                                                        Padding="11,0"
                                                        Command="{StaticResource SizeLimitationCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        GroupName="SizeLimitationRadioGroup"
                                                        IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                        Text="{x:Bind Value}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!--  视频编码  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('VideoEncoding')}" />

                        <DropDownButton
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{x:Bind SelectedVideoEncoding.Value, Mode=OneWay}">

                            <DropDownButton.Flyout>
                                <Flyout
                                    x:Name="VideoEncodingFlyout"
                                    Opened="{x:Bind OnVideoEncodingOpened}"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="False">

                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource OverlayCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                        <ListView
                                            x:Name="VideoEncodingListView"
                                            MaxHeight="300"
                                            Background="Transparent"
                                            ItemsSource="{x:Bind VideoEncodingList}"
                                            SelectionMode="None">

                                            <ListView.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="MinHeight" Value="0 " />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ItemsControl.ItemContainerTransitions>
                                                <TransitionCollection />
                                            </ItemsControl.ItemContainerTransitions>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="model:KeyValuePairModel">
                                                    <RadioMenuFlyoutItem
                                                        Height="32"
                                                        Padding="11,0"
                                                        Command="{StaticResource VideoEncodingCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        GroupName="VideoEncodingRadioGroup"
                                                        IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                        Text="{x:Bind Value}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!--  屏幕大小  -->
                    <Expander
                        Margin="0,0,0,2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        IsExpanded="True">

                        <Expander.Header>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('ScreenSize')}" />
                        </Expander.Header>

                        <StackPanel Padding="0">
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SelectScreenSize')}" />

                                <DropDownButton
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind SelectedScreenSize.Value, Mode=OneWay}">

                                    <DropDownButton.Flyout>
                                        <Flyout
                                            x:Name="ScreenSizeFlyout"
                                            Opened="{x:Bind OnScreenSizeOpened}"
                                            Placement="Bottom"
                                            ShouldConstrainToRootBounds="False">

                                            <Flyout.FlyoutPresenterStyle>
                                                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource OverlayCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                                <ListView
                                                    x:Name="ScreenSizeListView"
                                                    MaxHeight="300"
                                                    Background="Transparent"
                                                    ItemsSource="{x:Bind ScreenSizeList}"
                                                    SelectionMode="None">

                                                    <ListView.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="Margin" Value="0,1" />
                                                            <Setter Property="MinHeight" Value="0 " />
                                                        </Style>
                                                    </ListView.ItemContainerStyle>

                                                    <ItemsControl.ItemContainerTransitions>
                                                        <TransitionCollection />
                                                    </ItemsControl.ItemContainerTransitions>

                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="model:KeyValuePairModel">
                                                            <RadioMenuFlyoutItem
                                                                Height="32"
                                                                Padding="11,0"
                                                                Command="{StaticResource ScreenSizeCommand}"
                                                                CommandParameter="{x:Bind}"
                                                                GroupName="ScreenSizeRadioGroup"
                                                                IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                                Text="{x:Bind Value}" />
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>

                            <MenuFlyoutSeparator Visibility="{x:Bind GetSelectedScreenSize(SelectedScreenSize.Key, ScreenSizeList[17].Key), Mode=OneWay}" />

                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind GetSelectedScreenSize(SelectedScreenSize.Key, ScreenSizeList[17].Key), Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CustomSize')}" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Width')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="{x:Bind OnScreenWidthValueChanged}"
                                        Value="{x:Bind ScreenWidth, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Height')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="{x:Bind OnScreenHeightValueChanged}"
                                        Value="{x:Bind ScreenHeight, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!--  比特率  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('BitRate')}" />

                        <DropDownButton
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{x:Bind SelectedVideoBitRate.Value, Mode=OneWay}">

                            <DropDownButton.Flyout>
                                <Flyout
                                    x:Name="VideoBitRateFlyout"
                                    Opened="{x:Bind OnVideoBitRateOpened}"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="False">

                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource OverlayCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                        <ListView
                                            x:Name="VideoBitRateListView"
                                            MaxHeight="300"
                                            Background="Transparent"
                                            ItemsSource="{x:Bind VideoBitRateList}"
                                            SelectionMode="None">

                                            <ListView.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="MinHeight" Value="0 " />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ItemsControl.ItemContainerTransitions>
                                                <TransitionCollection />
                                            </ItemsControl.ItemContainerTransitions>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="model:KeyValuePairModel">
                                                    <RadioMenuFlyoutItem
                                                        Height="32"
                                                        Padding="11,0"
                                                        Command="{StaticResource VideoBitRateCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        GroupName="VideoBitRateRadioGroup"
                                                        IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                        Text="{x:Bind Value}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!--  固定速率系数  -->
                    <Expander
                        Margin="0,0,0,2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        IsExpanded="True">

                        <Expander.Header>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('ConstantRatefactor')}" />
                        </Expander.Header>

                        <StackPanel Padding="0">
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('UseCRF')}" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('UseCRFOffContent')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(UseCRF), Mode=OneWay}" />

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('UseCRFOnContent')}"
                                        Visibility="{x:Bind UseCRF, Mode=OneWay}" />

                                    <ToggleSwitch
                                        MinWidth="0"
                                        Margin="10,-2,-10,0"
                                        IsOn="{x:Bind UseCRF, Mode=OneWay}"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="{x:Bind OnUseCRFToggled}" />
                                </StackPanel>
                            </Grid>

                            <MenuFlyoutSeparator Visibility="{x:Bind UseCRF, Mode=OneWay}" />

                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind UseCRF, Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CRFSize')}">

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                                <Grid Padding="{StaticResource ToolTipBorderPadding}">

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CRFSizeScale')}" />
                                                    <TextBlock Grid.Row="1" Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CRFSizeInformation')}" />
                                                </Grid>
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </TextBlock>

                                <NumberBox
                                    Grid.Column="2"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    LargeChange="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="{x:Bind OnCRFValueChanged}"
                                    Value="{x:Bind CRF, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!--  GPU  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('GPU')}" />

                        <DropDownButton
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{x:Bind SelectedGPU.Value, Mode=OneWay}">

                            <DropDownButton.Flyout>
                                <Flyout
                                    x:Name="GPUFlyout"
                                    Opened="{x:Bind OnGPUOpened}"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="False">

                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource OverlayCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                        <ListView
                                            x:Name="GPUListView"
                                            MaxHeight="300"
                                            Background="Transparent"
                                            ItemsSource="{x:Bind GPUList}"
                                            SelectionMode="None">

                                            <ListView.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="MinHeight" Value="0 " />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ItemsControl.ItemContainerTransitions>
                                                <TransitionCollection />
                                            </ItemsControl.ItemContainerTransitions>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="model:KeyValuePairModel">
                                                    <RadioMenuFlyoutItem
                                                        Height="32"
                                                        Padding="11,0"
                                                        Command="{StaticResource GPUCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        GroupName="GPURadioGroup"
                                                        IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                        Text="{x:Bind Value}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <TextBlock
                        x:Name="AudioHeader"
                        Margin="2,0,0,5"
                        FontSize="16"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Audio')}" />

                    <TextBlock
                        x:Name="SubtitleHeader"
                        Margin="2,0,0,5"
                        FontSize="16"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Subtitle')}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Page>
</Window>
