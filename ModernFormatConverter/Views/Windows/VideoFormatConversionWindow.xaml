<Window
    x:Class="ModernFormatConverter.Views.Dialogs.VideoFormatConversionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:class="using:ModernFormatConverter.Extensions.DataType.Class"
    xmlns:collection="using:System.Collections"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ModernFormatConverter.Models"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:system="using:System"
    xmlns:window="using:ModernFormatConverter.Views.Windows"
    Title="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Title')}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}"
    mc:Ignorable="d">

    <Page
        x:Name="VideoFormatConversionPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind ((FrameworkElement)window:MainWindow.Current.Content).FlowDirection, Mode=OneWay}"
        Loaded="{x:Bind OnLoaded}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  视频输出配置标题栏  -->
            <TitleBar
                x:Name="AppTitlebar"
                Title="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Title')}"
                Grid.Row="0"
                Height="30"
                Padding="0"
                VerticalAlignment="Top">

                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarExpandedHeight">30</x:Double>
                </TitleBar.Resources>

                <TitleBar.LeftHeader>
                    <ImageIcon
                        Grid.Column="1"
                        MaxWidth="16"
                        MaxHeight="16"
                        Margin="10,0,-4,0"
                        Source="ms-appx:///Assets/ControlIcon/Settings.png" />
                </TitleBar.LeftHeader>
            </TitleBar>

            <Grid Grid.Row="1" Margin="6,0,6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <SelectorBar
                    x:Name="VideoFormatConversionSelectorBar"
                    Grid.Column="0"
                    Margin="-8,-4,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SelectedItem="{x:Bind SelectedItem, Mode=OneWay}"
                    SelectionChanged="{x:Bind OnSelectorBarSelectionChanged}">

                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Video')}" />
                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Audio')}" />
                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Subtitle')}" />
                </SelectorBar>

                <CommandBar
                    Grid.Column="1"
                    Height="36"
                    Margin="0,0,-10,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    DefaultLabelPosition="Right">

                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            Click="{x:Bind OnOkClicked}"
                            Label="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('OK')}"
                            Style="{StaticResource AppBarButtonStyle}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8FB;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>

            <MenuFlyoutSeparator Grid.Row="2" Margin="6,0,6,3" />

            <ScrollViewer
                x:Name="VideoFormatConversionScroll"
                Grid.Row="3"
                Padding="8,0,10,3"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ViewChanged="{x:Bind OnViewChanged}">

                <StackPanel>
                    <TextBlock
                        x:Name="VideoHeader"
                        Margin="2,0,0,5"
                        FontSize="16"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Video')}" />

                    <!--  格式转换类型  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('FormatConversionType')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind FormatConversionTypeList}"
                            SelectedItem="{x:Bind SelectedFormatConversionType, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnFormatConversionTypeSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  视频编码  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('VideoEncoding')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind VideoEncodingCollection}"
                            SelectedItem="{x:Bind SelectedVideoEncoding, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnVideoEncodingSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  大小限制  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SizeLimitation')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind SizeLimitationCollection}"
                            SelectedItem="{x:Bind SelectedSizeLimitation, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnSizeLimitationSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  屏幕大小  -->
                    <Expander
                        Margin="0,0,0,2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        IsExpanded="True">

                        <Expander.Header>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('ScreenSize')}" />
                        </Expander.Header>

                        <StackPanel Padding="0">
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SelectScreenSize')}" />

                                <ComboBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Value"
                                    ItemsSource="{x:Bind ScreenSizeCollection}"
                                    SelectedItem="{x:Bind SelectedScreenSize, Mode=OneWay}"
                                    SelectedValuePath="Key"
                                    SelectionChanged="{x:Bind OnScreenSizeSelectionChanged}"
                                    Style="{StaticResource ComboBoxStyle}" />
                            </Grid>

                            <MenuFlyoutSeparator Visibility="{x:Bind GetIsCustomScreenSizeSelected(SelectedScreenSize), Mode=OneWay}" />

                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind GetIsCustomScreenSizeSelected(SelectedScreenSize), Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CustomSize')}" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Width')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="{x:Bind OnScreenWidthValueChanged}"
                                        Value="{x:Bind ScreenWidth, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Height')}" />

                                    <NumberBox
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="{x:Bind OnScreenHeightValueChanged}"
                                        Value="{x:Bind ScreenHeight, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!--  比特率  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('BitRate')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind VideoBitRateCollection}"
                            SelectedItem="{x:Bind SelectedVideoBitRate, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnVideoBitRateSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  固定速率系数  -->
                    <Expander
                        Margin="0,0,0,2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        IsExpanded="True">

                        <Expander.Header>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('ConstantRatefactor')}" />
                        </Expander.Header>

                        <StackPanel Padding="0">
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('UseCRF')}" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('UseCRFOffContent')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(UseCRF), Mode=OneWay}" />

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('UseCRFOnContent')}"
                                        Visibility="{x:Bind UseCRF, Mode=OneWay}" />

                                    <ToggleSwitch
                                        MinWidth="0"
                                        Margin="10,-2,-10,0"
                                        IsEnabled="{x:Bind IsCRFSupported, Mode=OneWay}"
                                        IsOn="{x:Bind UseCRF, Mode=OneWay}"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="{x:Bind OnUseCRFToggled}" />
                                </StackPanel>
                            </Grid>

                            <MenuFlyoutSeparator Visibility="{x:Bind UseCRF, Mode=OneWay}" />

                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind UseCRF, Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CRFSize')}">

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                                <Grid Padding="{StaticResource ToolTipBorderPadding}">

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CRFSizeScale')}" />
                                                    <TextBlock Grid.Row="1" Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CRFSizeInformation')}" />
                                                </Grid>
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </TextBlock>

                                <Slider
                                    Grid.Column="2"
                                    Width="200"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Maximum="50"
                                    Minimum="10"
                                    SmallChange="1"
                                    StepFrequency="1"
                                    ValueChanged="{x:Bind OnCRFValueChanged}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!--  GPU  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('GPU')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind GPUCollection}"
                            SelectedItem="{x:Bind SelectedGPU, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnGPUSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  每秒帧数  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('FramePerSecond')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind FramePerSecondList}"
                            SelectedItem="{x:Bind SelectedFramePerSecond, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnFramePerSecondSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  宽高比  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('AspectRatio')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind AspectRatioCollection}"
                            SelectedItem="{x:Bind SelectedAspectRatio, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnAspectRatioSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  二次编码  -->
                    <Grid
                        Grid.Row="2"
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SecondaryEncoding')}" />

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SecondaryEncodingOffContent')}"
                                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(SecondaryEncoding), Mode=OneWay}" />

                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SecondaryEncodingOnContent')}"
                                Visibility="{x:Bind SecondaryEncoding, Mode=OneWay}" />

                            <ToggleSwitch
                                MinWidth="0"
                                Margin="10,-2,-10,0"
                                IsEnabled="{x:Bind IsSecondaryEncodingEnabled, Mode=OneWay}"
                                IsOn="{x:Bind SecondaryEncoding, Mode=OneWay}"
                                OffContent=""
                                OnContent=""
                                Toggled="{x:Bind OnSecondaryEncodingToggled}" />
                        </StackPanel>
                    </Grid>

                    <!--  关键帧间隔  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('KeyFrameInterval')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind KeyFrameIntervalCollection}"
                            SelectedItem="{x:Bind SelectedKeyFrameInterval, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnKeyFrameIntervalSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  反交错  -->
                    <Grid
                        Grid.Row="2"
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('DeInterlace')}" />

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('DeInterlaceOffContent')}"
