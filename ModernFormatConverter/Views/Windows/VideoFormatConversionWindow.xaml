<Window
    x:Class="ModernFormatConverter.Views.Dialogs.VideoFormatConversionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:system="using:System"
    xmlns:window="using:ModernFormatConverter.Views.Windows"
    Title="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Title')}"
    SystemBackdrop="{x:Bind WindowSystemBackdrop, Mode=OneWay}"
    mc:Ignorable="d">

    <Page
        x:Name="ConversionToolsPage"
        ActualThemeChanged="{x:Bind OnActualThemeChanged}"
        FlowDirection="{x:Bind ((FrameworkElement)window:MainWindow.Current.Content).FlowDirection, Mode=OneWay}"
        Loaded="{x:Bind OnLoaded}"
        RequestedTheme="{x:Bind WindowTheme, Mode=OneWay}">

        <Page.Resources>
            <ResourceDictionary>
                <MenuFlyout x:Name="TitlebarMenuFlyout" Placement="BottomEdgeAlignedLeft">

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Restore')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE923;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnMoveClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Move')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnSizeClicked}"
                        FontSize="12"
                        Tag="{x:Bind TitlebarMenuFlyout}"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Size')}" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Minimize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE921;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        FontSize="12"
                        IsEnabled="False"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Maximize')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE922;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Width="200" />

                    <MenuFlyoutItem
                        Height="28"
                        Padding="11,0"
                        Click="{x:Bind OnCloseClicked}"
                        FontSize="12"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Close')}">

                        <MenuFlyoutItem.Icon>
                            <FontIcon Margin="6" Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>

                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ResourceDictionary>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  视频输出配置标题栏  -->
            <TitleBar
                x:Name="AppTitlebar"
                Title="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Title')}"
                Grid.Row="0"
                Height="30"
                Padding="0"
                VerticalAlignment="Top">

                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarExpandedHeight">30</x:Double>
                </TitleBar.Resources>

                <TitleBar.LeftHeader>
                    <ImageIcon
                        Grid.Column="1"
                        MaxWidth="16"
                        MaxHeight="16"
                        Margin="10,0,-4,0"
                        Source="ms-appx:///Assets/ControlIcon/Settings.png" />
                </TitleBar.LeftHeader>
            </TitleBar>

            <Grid Grid.Row="1" Margin="6,0,6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <SelectorBar
                    x:Name="VideoOutputConfigurationSelectorBar"
                    Grid.Column="0"
                    Margin="-8,-4,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SelectedItem="{x:Bind SelectedItem, Mode=OneWay}"
                    SelectionChanged="{x:Bind OnSelectorBarSelectionChanged}">

                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Video')}" />
                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Audio')}" />
                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Subtitle')}" />
                </SelectorBar>

                <CommandBar
                    Grid.Column="1"
                    Height="36"
                    Margin="0,0,-10,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    DefaultLabelPosition="Right">

                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            Click="{x:Bind OnSegmentationClicked}"
                            Label="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Segmentation')}"
                            Style="{StaticResource AppBarButtonStyle}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C6;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton
                            Click="{x:Bind OnOkClicked}"
                            Label="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('OK')}"
                            Style="{StaticResource AppBarButtonStyle}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8FB;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>

            <MenuFlyoutSeparator Grid.Row="2" Margin="6,0,6,3" />

            <ScrollViewer
                Grid.Row="3"
                Padding="8,0,10,3"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ViewChanged="{x:Bind OnViewChanged}">

                <StackPanel>
                    <TextBlock
                        x:Name="VideoHeader"
                        Margin="2,0,0,5"
                        FontSize="16"
                        Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Video')}" />

                    <!--  视频编辑  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('VideoEdit')}" />

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="{x:Bind OnVideoEditClicked}"
                            Content="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Edit')}" />
                    </Grid>

                    <!--  格式转换类型  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('FormatConversionType')}" />

                        <DropDownButton
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Content="{x:Bind SelectedFormatConversionType.Value, Mode=OneWay}">

                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[0].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[0]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[0].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[1].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[1]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[1].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[2].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[2]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[2].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[3].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[3]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[3].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[4].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[4]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[4].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[5].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[5]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[5].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[6].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[6]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[6].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[7].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[7]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[7].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[8].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[8]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[8].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[9].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[9]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[9].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[10].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[10]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[10].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[11].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[11]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[11].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[12].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[12]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[12].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[13].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[13]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[13].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                        GroupName="FormatConversionTypeRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[14].Key), Mode=OneWay}"
                                        Tag="{x:Bind FormatConversionTypeList[14]}"
                                        Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[14].Value)}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!--  大小限制  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SizeLimitation')}" />

                        <DropDownButton
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Content="{x:Bind SelectedSizeLimitation.Value, Mode=OneWay}">

                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[0].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[0]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[0].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[1].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[1]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[1].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[2].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[2]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[2].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[3].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[3]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[3].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[4].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[4]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[4].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[5].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[5]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[5].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[6].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[6]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[6].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[7].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[7]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[7].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[8].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[8]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[8].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[9].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[9]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[9].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[10].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[10]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[10].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[11].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[11]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[11].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[12].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[12]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[12].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[13].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[13]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[13].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[14].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[14]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[14].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[15].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[15]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[15].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[16].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[16]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[16].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                        GroupName="SizeLimitationRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[17].Key), Mode=OneWay}"
                                        Tag="{x:Bind SizeLimitationList[17]}"
                                        Text="{x:Bind system:Convert.ToString(SizeLimitationList[17].Value)}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!--  视频编码  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('VideoEncoding')}" />

                        <DropDownButton
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Content="{x:Bind SelectedVideoEncoding.Value, Mode=OneWay}">

                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnVideoEncodingRadioGroupSelectClicked}"
                                        GroupName="VideoEncodingRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedVideoEncoding.Key, VideoEncodingList[0].Key), Mode=OneWay}"
                                        Tag="{x:Bind VideoEncodingList[0]}"
                                        Text="{x:Bind system:Convert.ToString(VideoEncodingList[0].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnVideoEncodingRadioGroupSelectClicked}"
                                        GroupName="VideoEncodingRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedVideoEncoding.Key, VideoEncodingList[1].Key), Mode=OneWay}"
                                        Tag="{x:Bind VideoEncodingList[1]}"
                                        Text="{x:Bind system:Convert.ToString(VideoEncodingList[1].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnVideoEncodingRadioGroupSelectClicked}"
                                        GroupName="VideoEncodingRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedVideoEncoding.Key, VideoEncodingList[2].Key), Mode=OneWay}"
                                        Tag="{x:Bind VideoEncodingList[2]}"
                                        Text="{x:Bind system:Convert.ToString(VideoEncodingList[2].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnVideoEncodingRadioGroupSelectClicked}"
                                        GroupName="VideoEncodingRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedVideoEncoding.Key, VideoEncodingList[3].Key), Mode=OneWay}"
                                        Tag="{x:Bind VideoEncodingList[3]}"
                                        Text="{x:Bind system:Convert.ToString(VideoEncodingList[3].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnVideoEncodingRadioGroupSelectClicked}"
                                        GroupName="VideoEncodingRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedVideoEncoding.Key, VideoEncodingList[4].Key), Mode=OneWay}"
                                        Tag="{x:Bind VideoEncodingList[4]}"
                                        Text="{x:Bind system:Convert.ToString(VideoEncodingList[4].Value)}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnVideoEncodingRadioGroupSelectClicked}"
                                        GroupName="VideoEncodingRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedVideoEncoding.Key, VideoEncodingList[5].Key), Mode=OneWay}"
                                        Tag="{x:Bind VideoEncodingList[5]}"
