                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Vertical">

                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('AdditionalSubtitle')}" />

                            <TextBlock
                                Margin="0,0,5,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                Visibility="{x:Bind CheckAdditionalSubtitlePath(AdditionalSubtitlePath), Mode=OneWay}">

                                <Hyperlink Click="{x:Bind OnAdditionalSubtitlePathClicked}" UnderlineStyle="None">
                                    <Run Text="{x:Bind AdditionalSubtitlePath, Mode=OneWay}" />
                                </Hyperlink>

                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        MaxWidth="9999"
                                        Padding="0"
                                        Background="Transparent">

                                        <Grid>
                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                            <StackPanel Padding="{StaticResource ToolTipBorderPadding}" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('AdditionalSubtitlePath')}" />
                                                <TextBlock Text="{x:Bind AdditionalSubtitlePath, Mode=OneWay}" />
                                                <MenuFlyoutSeparator Margin="4,3" />
                                                <TextBlock Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('OpenFolder')}" />
                                            </StackPanel>
                                        </Grid>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </TextBlock>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Margin="5,0,-5,0"
                            Padding="0"
                            Click="{x:Bind OnSelectAdditionalSubtitleClicked}"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <FontIcon FontSize="14" Glyph="&#xE838;" />

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SelectAdditionalSubtitle')}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>

                    <!--  字幕嵌入类型  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('SubtitleNestType')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind SubtitleNestTypeList}"
                            SelectedItem="{x:Bind SelectedSubtitleNestType, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnSubtitleNestTypeSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  字体名称  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('FontName')}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            VerticalAlignment="Center"
                            Text="{x:Bind FontName, Mode=OneWay}" />

                        <Button
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Click="{x:Bind OnChangeFontNameClicked}"
                            Content="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Change')}" />
                    </Grid>

                    <!--  字体大小  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('FontSize')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind FontSizeList}"
                            SelectedItem="{x:Bind SelectedFontSize, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnFontSizeSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  字体颜色  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('FontColor')}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            VerticalAlignment="Center"
                            Text="{x:Bind FontColor, Mode=OneWay}" />

                        <Button
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Click="{x:Bind OnChangeFontColorClicked}"
                            Content="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Change')}" />
                    </Grid>

                    <!--  字体边框风格  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('FontBorderStyle')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind FontBorderStyleList}"
                            SelectedItem="{x:Bind SelectedFontBorderStyle, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnFontBorderStyleSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  轮廓线大小  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CounterLineSize')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind CounterLineSizeList}"
                            SelectedItem="{x:Bind SelectedCounterLineSize, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnCounterLineSizeSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  轮廓线颜色  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('CounterLineColor')}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            VerticalAlignment="Center"
                            Text="{x:Bind CounterLineColor, Mode=OneWay}" />

                        <Button
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Click="{x:Bind OnChangeCounterLineColorClicked}"
                            Content="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('Change')}" />
                    </Grid>

                    <!--  阴影大小  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.VideoFormatConversionResource.GetString('ShadowSize')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Value"
                            ItemsSource="{x:Bind ShadowSizeList}"
                            SelectedItem="{x:Bind SelectedShadowSize, Mode=OneWay}"
                            SelectedValuePath="Key"
                            SelectionChanged="{x:Bind OnShadowSizeSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Page>
</Window>
