<ContentDialog
    x:Class="ModernFormatConverter.Views.Dialogs.VideoOutputConfigurationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:system="using:System"
    Background="{StaticResource ContentDialogBackground}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">3</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">768</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">768</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">560</x:Double>
    </ContentDialog.Resources>

    <Grid Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  视频输出配置标题栏  -->
        <Grid
            Grid.Row="0"
            Margin="-1,-1,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Margin="8,0,0,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE713;" />

            <TextBlock
                Grid.Column="1"
                Margin="8,0,0,3"
                VerticalAlignment="Center"
                Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('VideoOutputConfiguration')}" />

            <Button
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="{x:Bind OnCloseClicked}"
                Style="{StaticResource AlternateCloseButtonStyle}">

                <FontIcon
                    Margin="4"
                    FontSize="16"
                    Glyph="&#xE711;" />

                <ToolTipService.ToolTip>
                    <ToolTip
                        MaxWidth="9999"
                        Padding="0"
                        Background="Transparent">

                        <Grid>
                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Close')}" />
                        </Grid>
                    </ToolTip>
                </ToolTipService.ToolTip>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="6,2,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <SelectorBar
                x:Name="VideoOutputConfigurationSelectorBar"
                Grid.Column="0"
                Margin="0,-4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                SelectedItem="{x:Bind SelectedItem, Mode=OneWay}"
                SelectionChanged="{x:Bind OnSelectorBarSelectionChanged}">

                <SelectorBarItem Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Video')}" />
                <SelectorBarItem Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Audio')}" />
                <SelectorBarItem Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Subtitle')}" />
            </SelectorBar>

            <CommandBar
                Grid.Column="1"
                Height="36"
                Margin="0,0,-10,0"
                Padding="0"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right">

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnSegmentationClicked}"
                        Label="{x:Bind rootservice:ResourceService.DialogResource.GetString('Segmentation')}"
                        Style="{StaticResource AppBarButtonStyle}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8C6;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnOkClicked}"
                        Label="{x:Bind rootservice:ResourceService.DialogResource.GetString('OK')}"
                        Style="{StaticResource AppBarButtonStyle}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8FB;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>
        </Grid>

        <MenuFlyoutSeparator Grid.Row="2" Margin="6,0,6,3" />

        <ScrollViewer
            Grid.Row="3"
            Margin="6,0,6,3"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            ViewChanged="{x:Bind OnViewChanged}">

            <StackPanel>
                <TextBlock
                    x:Name="VideoHeader"
                    Margin="2,0,0,5"
                    FontSize="16"
                    Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Video')}" />

                <!--  视频编辑  -->
                <Grid
                    Height="60"
                    Margin="0,0,0,2"
                    Padding="16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('VideoEdit')}" />

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="{x:Bind OnVideoEditClicked}"
                        Content="{x:Bind rootservice:ResourceService.DialogResource.GetString('Edit')}" />
                </Grid>

                <!--  格式转换类型  -->
                <Grid
                    Height="60"
                    Margin="0,0,0,2"
                    Padding="16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('FormatConversionType')}" />

                    <DropDownButton
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Content="{x:Bind SelectedFormatConversionType.Value, Mode=OneWay}">

                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[0].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[0]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[0].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[1].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[1]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[1].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[2].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[2]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[2].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[3].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[3]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[3].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[4].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[4]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[4].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[5].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[5]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[5].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[6].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[6]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[6].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[7].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[7]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[7].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[8].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[8]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[8].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[9].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[9]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[9].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[10].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[10]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[10].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[11].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[11]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[11].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[12].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[12]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[12].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[13].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[13]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[13].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnFormatConversionTypeRadioGroupSelectClicked}"
                                    GroupName="FormatConversionTypeRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedFormatConversionType.Key, FormatConversionTypeList[14].Key), Mode=OneWay}"
                                    Tag="{x:Bind FormatConversionTypeList[14]}"
                                    Text="{x:Bind system:Convert.ToString(FormatConversionTypeList[14].Value)}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <!--  大小限制  -->
                <Grid
                    Height="60"
                    Margin="0,0,0,2"
                    Padding="16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('SizeLimitation')}" />

                    <DropDownButton
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Content="{x:Bind SelectedSizeLimitation.Value, Mode=OneWay}">

                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[0].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[0]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[0].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[1].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[1]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[1].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[2].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[2]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[2].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[3].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[3]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[3].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[4].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[4]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[4].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[5].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[5]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[5].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[6].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[6]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[6].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[7].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[7]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[7].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[8].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[8]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[8].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[9].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[9]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[9].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[10].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[10]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[10].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[11].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[11]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[11].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[12].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[12]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[12].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[13].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[13]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[13].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[14].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[14]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[14].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[15].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[15]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[15].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[16].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[16]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[16].Value)}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSizeLimitationRadioGroupSelectClicked}"
                                    GroupName="SizeLimitationRadioGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSizeLimitation.Key, SizeLimitationList[17].Key), Mode=OneWay}"
                                    Tag="{x:Bind SizeLimitationList[17]}"
                                    Text="{x:Bind system:Convert.ToString(SizeLimitationList[17].Value)}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <!--  屏幕大小  -->
                <Expander
                    Margin="0,0,0,2"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsExpanded="True">

                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('ScreenSizeSettings')}" />
                        </Grid>
                    </Expander.Header>

                    <StackPanel Padding="0">
                        <Grid
                            Height="52"
                            Padding="16,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('ScreenSize')}" />

                            <DropDownButton
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Content="{x:Bind SelectedScreenSize.Value, Mode=OneWay}">

                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <RadioMenuFlyoutItem
                                            Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                            GroupName="ScreenSizeRadioGroup"
                                            IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[0].Key), Mode=OneWay}"
                                            Tag="{x:Bind ScreenSizeList[0]}"
                                            Text="{x:Bind system:Convert.ToString(ScreenSizeList[0].Value)}" />

                                        <MenuFlyoutSubItem Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('ProgressiveScanning')}">
                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[1].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[1]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[1].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[2].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[2]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[2].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[3].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[3]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[3].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[4].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[4]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[4].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[5].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[5]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[5].Value)}" />
                                        </MenuFlyoutSubItem>

                                        <MenuFlyoutSubItem Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('InterlacedScanning')}">
                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[6].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[6]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[6].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[7].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[7]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[7].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[8].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[8]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[8].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[9].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[9]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[9].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[10].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[10]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[10].Value)}" />
                                        </MenuFlyoutSubItem>

                                        <MenuFlyoutSubItem Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Scale')}">
                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[11].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[11]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[11].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[12].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[12]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[12].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[13].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[13]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[13].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[14].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[14]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[14].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[15].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[15]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[15].Value)}" />

                                            <RadioMenuFlyoutItem
                                                Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                                GroupName="ScreenSizeRadioGroup"
                                                IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[16].Key), Mode=OneWay}"
                                                Tag="{x:Bind ScreenSizeList[16]}"
                                                Text="{x:Bind system:Convert.ToString(ScreenSizeList[16].Value)}" />
                                        </MenuFlyoutSubItem>

                                        <RadioMenuFlyoutItem
                                            Click="{x:Bind OnScreenSizeRadioGroupSelectClicked}"
                                            GroupName="ScreenSizeRadioGroup"
                                            IsChecked="{x:Bind x:Object.Equals(SelectedScreenSize.Key, ScreenSizeList[17].Key), Mode=OneWay}"
                                            Tag="{x:Bind ScreenSizeList[17]}"
                                            Text="{x:Bind system:Convert.ToString(ScreenSizeList[17].Value)}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <MenuFlyoutSeparator Visibility="{x:Bind GetSelectedScreenSize(SelectedScreenSize.Key, ScreenSizeList[17].Key), Mode=OneWay}" />

                        <Grid
                            Height="52"
                            Padding="16,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind GetSelectedScreenSize(SelectedScreenSize.Key, ScreenSizeList[17].Key), Mode=OneWay}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('CustomSize')}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Width')}" />

                                <NumberBox
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    LargeChange="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="{x:Bind OnScreenWidthValueChanged}"
                                    Value="{x:Bind ScreenWidth, Mode=OneWay}" />

                                <TextBlock
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Height')}" />

                                <NumberBox
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    LargeChange="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="{x:Bind OnScreenHeightValueChanged}"
                                    Value="{x:Bind ScreenHeight, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <TextBlock
                    x:Name="AudioHeader"
                    Margin="2,0,0,5"
                    FontSize="16"
                    Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Audio')}" />

                <TextBlock
                    x:Name="SubtitleHeader"
                    Margin="2,0,0,5"
                    FontSize="16"
                    Text="{x:Bind rootservice:ResourceService.DialogResource.GetString('Subtitle')}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
