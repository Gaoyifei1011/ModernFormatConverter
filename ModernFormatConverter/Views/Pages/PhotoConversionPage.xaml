<Page
    x:Class="ModernFormatConverter.Views.Pages.PhotoConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:class="using:ModernFormatConverter.Extensions.DataType.Class"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ModernFormatConverter.Models"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:system="using:System"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">1,0,0,0</Thickness>
            <Thickness x:Key="NavigationViewContentMargin">6,0,0,0</Thickness>
            <Thickness x:Key="NavigationViewPaneContentGridMargin">-1,10,0,3</Thickness>

            <class:ExecuteCommand x:Name="RemoveCommand" ExecuteRequested="{x:Bind OnRemoveExecuteRequested}" />
            <class:ExecuteCommand x:Name="OutputConfigurationCommand" ExecuteRequested="{x:Bind OnOutputConfigurationExecuteRequested}" />

            <DataTemplate x:Key="PhotoCardDataTemplate" x:DataType="model:PhotoConversionFileModel">
                <!--  图片转换卡片数据模板  -->
                <Grid
                    Height="100"
                    Margin="16,0,12,5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Width="120"
                        Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">

                        <Image Grid.Column="0" Source="{x:Bind FileThumbnailSource, Mode=OneWay}" />
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        RowSpacing="5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind FileName}"
                            TextLineBounds="TrimToCapHeight"
                            TextWrapping="NoWrap">

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent"
                                    Visibility="{Binding ElementName=DescriptionText, Path=IsTextTrimmed, Mode=OneWay}">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind FilePath}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </TextBlock>

                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis">

                            <Run Text="{x:Bind FileSizeString}" />
                            <Run Text=" | " />
                            <Run Text="{x:Bind system:Convert.ToString(ImageWidth)}" /><Run Text="x" /><Run Text="{x:Bind system:Convert.ToString(ImageHeight)}" />
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="2" Margin="5,0,20,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="5,0,0,0"
                            Padding="7"
                            Command="{StaticResource OutputConfigurationCommand}"
                            CommandParameter="{x:Bind}"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <AnimatedIcon>
                                <AnimatedIcon.Source>
                                    <animatedvisuals:AnimatedSettingsVisualSource />
                                </AnimatedIcon.Source>
                                <AnimatedIcon.FallbackIconSource>
                                    <FontIconSource Glyph="&#xE713;" />
                                </AnimatedIcon.FallbackIconSource>
                            </AnimatedIcon>

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('OutputConfiguration')}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Margin="5,0,0,0"
                            Padding="0"
                            Command="{StaticResource RemoveCommand}"
                            CommandParameter="{x:Bind}"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <FontIcon FontSize="16" Glyph="&#xE894;" />

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Remove')}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            Margin="10,0,0,0"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemsSource="{x:Bind PhotoConversionTypeCollection}"
            OpenPaneLength="300"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind SelectedConversionType, Mode=OneWay}">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="model:PhotoConversionTypeModel">
                    <NavigationViewItem>
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind PhotoConversionIcon}" />
                        </NavigationViewItem.Icon>

                        <TextBlock
                            x:Name="PhotoConversionTypeText"
                            Text="{x:Bind PhotoConversionType}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap">

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent"
                                    Visibility="{Binding ElementName=PhotoConversionTypeText, Path=IsTextTrimmed, Mode=OneWay}">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind PhotoConversionType}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <NavigationView.MenuItemContainerStyle>
                <Style BasedOn="{StaticResource NavigationViewItemStyle}" TargetType="NavigationViewItem">
                    <Setter Property="IsEnabled" Value="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}" />
                </Style>
            </NavigationView.MenuItemContainerStyle>

            <Grid
                AllowDrop="True"
                Background="Transparent"
                DragEnter="{x:Bind OnPhotoConversionDragEnter}"
                Drop="{x:Bind OnPhotoConversionDrop}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="30,15,30,5"
                    FontSize="22"
                    Text="{x:Bind SelectedConversionType.PhotoConversionType, Mode=OneWay}" />

                <!--  正在加载文件信息中  -->
                <Grid
                    Grid.Row="1"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="2"
                    ColumnSpacing="10"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind IsGettingFileInformation, Mode=OneWay}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressRing
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        IsActive="{x:Bind IsGettingFileInformation, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('GettingFileInformation')}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  图片转换控件  -->
                <Grid Grid.Row="1" Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                    <!--  添加文件信息提示和按钮  -->
                    <Grid
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(SelectedConversionType.PhotoConversionFileCollection.Count), Mode=OneWay}">

                        <Grid
                            Margin="30"
                            Canvas.ZIndex="1"
                            RowSpacing="15">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('DragAddFileTip')}" />

                            <Button
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="{x:Bind OnAddFileClicked}"
                                Content="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('AddFile')}" />
                        </Grid>

                        <Rectangle
                            Canvas.ZIndex="0"
                            Fill="Transparent"
                            RadiusX="4"
                            RadiusY="4"
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeDashArray="5,2"
                            StrokeThickness="1" />
                    </Grid>

                    <!--  图片转换文件信息列表  -->
                    <ListView
                        Grid.Row="1"
                        Padding="0,0,0,30"
                        ItemTemplate="{StaticResource PhotoCardDataTemplate}"
                        ItemsSource="{x:Bind SelectedConversionType.PhotoConversionFileCollection, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        SelectionMode="None"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(SelectedConversionType.PhotoConversionFileCollection.Count), Mode=OneWay}" />
                </Grid>
            </Grid>
        </NavigationView>

        <!--  操作栏  -->
        <Grid
            Grid.Row="1"
            Padding="10,5,24,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource ContentDialogBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,5,0"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE8CB;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="PhotoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[0]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[0]}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('NotSort')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="PhotoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[1]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[1]}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('SortByFileName')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="PhotoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[2]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[2]}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('SortByFileSize')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="PhotoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[3]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[3]}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('SortByImageWidth')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="PhotoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[4]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[3]}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('SortByImageHeight')}" />

                                <MenuFlyoutSeparator />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortWayClicked}"
                                    GroupName="PhotoSortWayGroup"
                                    IsChecked="{x:Bind SortWay, Mode=OneWay}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('SortIncrease')}">

                                    <RadioMenuFlyoutItem.Tag>
                                        <x:Boolean>True</x:Boolean>
                                    </RadioMenuFlyoutItem.Tag>
                                </RadioMenuFlyoutItem>

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortWayClicked}"
                                    GroupName="PhotoSortWayGroup"
                                    IsChecked="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(SortWay), Mode=OneWay}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('SortDecrease')}">

                                    <RadioMenuFlyoutItem.Tag>
                                        <x:Boolean>False</x:Boolean>
                                    </RadioMenuFlyoutItem.Tag>
                                </RadioMenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Sort')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="0,0,5,0"
                        Padding="0"
                        Click="{x:Bind OnClearClicked}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE711;" />

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Clear')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Margin="0,0,5,0"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE710;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem Click="{x:Bind OnAddFileClicked}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('AddFile')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem Click="{x:Bind OnAddFromFolderClicked}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('AddFromFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Add')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('OutputFolder')}" />

                    <TextBox
                        Grid.Column="1"
                        Width="350"
                        IsReadOnly="True"
                        Text="{x:Bind OutputFolder, Mode=OneWay}"
                        TextWrapping="NoWrap">

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind OutputFolder, Mode=OneWay}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBox>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="AppCache"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('AppCacheFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xECAA;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Photo"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('PhotoFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE91B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Desktop"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('DesktopFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Custom"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Custom')}" />
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('ChangeOutputFolder')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>
            </Grid>

            <Button
                Grid.Column="1"
                MinWidth="100"
                HorizontalAlignment="Stretch"
                Click="{x:Bind OnOkClicked}"
                Content="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('OK')}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
