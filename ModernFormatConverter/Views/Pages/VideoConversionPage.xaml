                                        TextTrimming="CharacterEllipsis">

                                        <Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.AudioFile.FileSize, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.AudioFile.Duration, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.AudioFile.Channel, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.AudioFile.SamplingRate, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.AudioFile.BitRate, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0,20,0"
                                    Padding="0"
                                    Click="{x:Bind OnRemoveVideoMixedFlowAudioFileClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE894;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Remove')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <TextBlock
                                Grid.Row="4"
                                FontSize="16"
                                Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SubtitleSection')}" />

                            <!--  字幕文件添加信息提示按钮  -->
                            <Grid
                                Grid.Row="5"
                                Height="100"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AllowDrop="{x:Bind x:Object.Equals(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow), Mode=OneWay}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                DragEnter="{x:Bind OnVideoMixedFlowDragEnter}"
                                Drop="{x:Bind OnVideoMixedFlowSubtitleDrop}"
                                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(SelectedConversionType.VideoMixedFlow.IsSubtitleFileExisted), Mode=OneWay}">

                                <Grid Margin="0" Canvas.ZIndex="1">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('DragAddSubtitleFileTip')}" />

                                    <Button
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Click="{x:Bind OnAddSubtitlefileClicked}"
                                        Content="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddSubtitleFile')}" />
                                </Grid>

                                <Rectangle
                                    Canvas.ZIndex="0"
                                    Fill="Transparent"
                                    RadiusX="4"
                                    RadiusY="4"
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeDashArray="5,2"
                                    StrokeThickness="1" />
                            </Grid>

                            <!--  字幕文件信息控件  -->
                            <Grid
                                Grid.Row="5"
                                Height="100"
                                Margin="0,0,0,5"
                                AllowDrop="{x:Bind x:Object.Equals(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow), Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                DragEnter="{x:Bind OnVideoMixedFlowDragEnter}"
                                Drop="{x:Bind OnVideoMixedFlowSubtitleDrop}"
                                Visibility="{x:Bind SelectedConversionType.VideoMixedFlow.IsSubtitleFileExisted, Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Grid.Column="0"
                                    Width="120"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,1,0">

                                    <Image Grid.Column="0" Source="{x:Bind SelectedConversionType.VideoMixedFlow.SubtitleFile.FileThumbnailSource, Mode=OneWay}" />
                                </Grid>

                                <Grid
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    RowSpacing="5">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind SelectedConversionType.VideoMixedFlow.SubtitleFile.FileName, Mode=OneWay}"
                                        TextLineBounds="TrimToCapHeight"
                                        TextWrapping="NoWrap">

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind SelectedConversionType.VideoMixedFlow.SubtitleFile.FilePath, Mode=OneWay}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </TextBlock>

                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SelectedConversionType.VideoMixedFlow.SubtitleFile.FileSize, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0,20,0"
                                    Padding="0"
                                    Click="{x:Bind OnRemoveVideoMixedFlowSubtitleFileClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE894;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Remove')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!--  非视频混流控件  -->
                    <Grid Visibility="{x:Bind converter:ValueCheckConverterHelper.GetVideoConversionType(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow, x:True), Mode=OneWay}">
                        <!--  添加文件信息提示和按钮  -->
                        <Grid
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(SelectedConversionType.VideoConversionFileCollection.Count), Mode=OneWay}">

                            <Grid
                                Margin="30"
                                Canvas.ZIndex="1"
                                RowSpacing="15">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('DragAddFileTip')}" />

                                <Button
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="{x:Bind OnAddFileClicked}"
                                    Content="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddFile')}" />
                            </Grid>

                            <Rectangle
                                Canvas.ZIndex="0"
                                Fill="Transparent"
                                RadiusX="4"
                                RadiusY="4"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeDashArray="5,2"
                                StrokeThickness="1" />
                        </Grid>

                        <Grid Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(SelectedConversionType.VideoConversionFileCollection.Count), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid
                                Grid.Row="0"
                                Height="35"
                                Margin="32,0,28,0"
                                HorizontalAlignment="Stretch"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,1"
                                Visibility="{x:Bind converter:ValueCheckConverterHelper.GetVideoConversionType(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoConcat, x:False), Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="FileNameHeaderText"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('FileName')}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent"
                                            Visibility="{x:Bind FileNameHeaderText.IsTextTrimmed, Mode=OneWay}">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('FileName')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </TextBlock>

                                <TextBlock
                                    x:Name="FileSizeHeaderText"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('FileSize')}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent"
                                            Visibility="{x:Bind FileSizeHeaderText.IsTextTrimmed, Mode=OneWay}">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('FileSize')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </TextBlock>

                                <TextBlock
                                    x:Name="DurationHeaderText"
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Duration')}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent"
                                            Visibility="{x:Bind DurationHeaderText.IsTextTrimmed, Mode=OneWay}">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Duration')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </TextBlock>

                                <TextBlock
                                    x:Name="ScreenSizeHeaderText"
                                    Grid.Column="3"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('ScreenSize')}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent"
                                            Visibility="{x:Bind ScreenSizeHeaderText.IsTextTrimmed, Mode=OneWay}">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('ScreenSize')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </TextBlock>

                                <TextBlock
                                    Grid.Column="4"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Options')}">

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Options')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                            </Grid>

                            <!--  视频转换文件信息列表  -->
                            <ListView
                                Grid.Row="1"
                                Padding="0,0,0,30"
                                ItemsSource="{x:Bind SelectedConversionType.VideoConversionFileCollection, Mode=OneWay}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                SelectionMode="None">

                                <ListView.ItemTemplateSelector>
                                    <datatemplate:VideoConversionDataTemplateSelector VideoCardDataTemplate="{StaticResource VideoCardDataTemplate}" VideoListDataTemplate="{StaticResource VideoListDataTemplate}" />
                                </ListView.ItemTemplateSelector>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>

        <!--  操作栏  -->
        <Grid
            Grid.Row="1"
            Padding="10,5,24,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource ContentDialogBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,5,0"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}"
                        Visibility="{x:Bind converter:ValueCheckConverterHelper.GetVideoConversionType(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow, x:True), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE8CB;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="VideoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[0]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[0]}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('NotSort')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="VideoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[1]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[1]}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortByFileName')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="VideoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[2]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[2]}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortByFileSize')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="VideoSortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[3]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[3]}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortByDuration')}" />

                                <MenuFlyoutSeparator />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortWayClicked}"
                                    GroupName="VideoSortWayGroup"
                                    IsChecked="{x:Bind SortWay, Mode=OneWay}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortIncrease')}">

                                    <RadioMenuFlyoutItem.Tag>
                                        <x:Boolean>True</x:Boolean>
                                    </RadioMenuFlyoutItem.Tag>
                                </RadioMenuFlyoutItem>

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortWayClicked}"
                                    GroupName="VideoSortWayGroup"
                                    IsChecked="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(SortWay), Mode=OneWay}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortDecrease')}">

                                    <RadioMenuFlyoutItem.Tag>
                                        <x:Boolean>False</x:Boolean>
                                    </RadioMenuFlyoutItem.Tag>
                                </RadioMenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Sort')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="0,0,5,0"
                        Padding="0"
                        Click="{x:Bind OnClearClicked}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE711;" />

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Clear')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Margin="0,0,5,0"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE710;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem
                                    Click="{x:Bind OnAddFileClicked}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddFile')}"
                                    Visibility="{x:Bind converter:ValueCheckConverterHelper.GetVideoConversionType(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow, x:True), Mode=OneWay}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSubItem Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddFile')}" Visibility="{x:Bind converter:ValueCheckConverterHelper.GetVideoConversionType(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow, x:False), Mode=OneWay}">

                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutSubItem.Icon>

                                    <MenuFlyoutSubItem.Items>
                                        <MenuFlyoutItem Click="{x:Bind OnAddVideoFileClicked}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddVideoFile')}">

                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE714;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutItem Click="{x:Bind OnAddAudiofileClicked}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddAudioFile')}">

                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8D6;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutItem Click="{x:Bind OnAddSubtitlefileClicked}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddSubtitleFile')}">

                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED1E;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyoutSubItem.Items>
                                </MenuFlyoutSubItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnAddFromFolderClicked}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddFromFolder')}"
                                    Visibility="{x:Bind converter:ValueCheckConverterHelper.GetVideoConversionType(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow, x:True), Mode=OneWay}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Add')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="3"
                        Width="32"
                        Height="32"
                        Padding="7"
                        Click="{x:Bind OnOutputConfigurationClicked}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}"
                        Visibility="{x:Bind converter:ValueCheckConverterHelper.GetVideoConversionType(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoSeparation, x:True), Mode=OneWay}">

                        <AnimatedIcon x:Name="SearchAnimatedIcon">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Find" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('OutputConfiguration')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('OutputFolder')}" />

                    <TextBox
                        Grid.Column="1"
                        Width="350"
                        IsReadOnly="True"
                        Text="{x:Bind OutputFolder, Mode=OneWay}"
                        TextWrapping="NoWrap">

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind OutputFolder, Mode=OneWay}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBox>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="AppCache"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AppCacheFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xECAA;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Video"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('VideoFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE714;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Desktop"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('DesktopFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Custom"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Custom')}" />
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('ChangeOutputFolder')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>
            </Grid>

            <Button
                Grid.Column="1"
                MinWidth="100"
                HorizontalAlignment="Stretch"
                Click="{x:Bind OnOkClicked}"
                Content="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('OK')}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
