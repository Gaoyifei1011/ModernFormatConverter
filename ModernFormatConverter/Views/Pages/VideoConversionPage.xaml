<Page
    x:Class="ModernFormatConverter.Views.Pages.VideoConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:class="using:ModernFormatConverter.Extensions.DataType.Class"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ModernFormatConverter.Models"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">1,0,0,0</Thickness>
            <Thickness x:Key="NavigationViewContentMargin">6,0,0,0</Thickness>
            <Thickness x:Key="NavigationViewPaneContentGridMargin">-1,10,0,3</Thickness>

            <class:ExecuteCommand x:Name="RemoveCommand" ExecuteRequested="{x:Bind OnRemoveExecuteRequested}" />
            <class:ExecuteCommand x:Name="OutputConfigurationCommand" ExecuteRequested="{x:Bind OnOutputConfigurationExecuteRequested}" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            Margin="10,0,0,0"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemsSource="{x:Bind ConversionTypeCollection}"
            OpenPaneLength="300"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind SelectedConversionType, Mode=OneWay}"
            SelectionChanged="{x:Bind OnSelectionChanged}">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="model:VideoConversionTypeModel">
                    <TextBlock
                        x:Name="VideoConversionTypeText"
                        Text="{x:Bind VideoConversionType}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{Binding ElementName=VideoConversionTypeText, Path=IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind VideoConversionType}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid
                AllowDrop="True"
                Background="Transparent"
                DragEnter="{x:Bind OnVideoConversionDragEnter}"
                Drop="{x:Bind OnVideoConversionDrop}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="30,15,30,5"
                    FontSize="22"
                    Text="{x:Bind SelectedConversionType.VideoConversionType, Mode=OneWay}" />

                <!--  正在加载文件信息中  -->
                <Grid
                    Grid.Row="1"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="2"
                    ColumnSpacing="10"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind IsGettingFileInformation, Mode=OneWay}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressRing
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        IsActive="{x:Bind IsGettingFileInformation, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('GettingFileInformation')}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Row="1" Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsGettingFileInformation), Mode=OneWay}">
                    <!--  添加文件信息提示和按钮  -->
                    <Grid
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(SelectedConversionType.VideoConversionFileCollection.Count), Mode=OneWay}">

                        <Grid
                            Margin="30"
                            Canvas.ZIndex="1"
                            RowSpacing="15">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('DragAddFileTip')}" />

                            <Button
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="{x:Bind OnAddFileClicked}"
                                Content="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddFile')}" />
                        </Grid>

                        <Rectangle
                            Canvas.ZIndex="0"
                            Fill="Transparent"
                            RadiusX="4"
                            RadiusY="4"
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeDashArray="5,2"
                            StrokeThickness="1" />
                    </Grid>

                    <!--  待转换的文件信息列表  -->
                    <ListView
                        ItemsSource="{x:Bind SelectedConversionType.VideoConversionFileCollection, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        SelectionMode="None"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(SelectedConversionType.VideoConversionFileCollection.Count), Mode=OneWay}">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:VideoConversionFileModel">
                                <Grid
                                    Height="100"
                                    Margin="16,0,12,5"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Grid.Column="0"
                                        Width="120"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,1,0">

                                        <Image Grid.Column="0" Source="{x:Bind FileThumbnailSource, Mode=OneWay}" />
                                    </Grid>

                                    <Grid
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        RowSpacing="5">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind FileName}"
                                            TextLineBounds="TrimToCapHeight"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Visibility="{Binding ElementName=DescriptionText, Path=IsTextTrimmed, Mode=OneWay}">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind FilePath}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            RelativePanel.Below="TitleText"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis">

                                            <Run Text="{x:Bind FileSizeString}" />
                                            <Run Text=" | " />
                                            <Run Text="{x:Bind DurationString}" />
                                            <Run Text=" | " />
                                            <Run Text="{x:Bind ScreenSizeWidth}" /><Run Text="x" /><Run Text="{x:Bind ScreenSizeHeight}" />
                                        </TextBlock>
                                    </Grid>

                                    <Grid
                                        Grid.Column="2"
                                        Margin="5,0,20,0"
                                        ColumnSpacing="5">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Command="{StaticResource RemoveCommand}"
                                            CommandParameter="{x:Bind}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">

                                            <FontIcon FontSize="16" Glyph="&#xE894;" />

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Remove')}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </Button>

                                        <Button
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Padding="6"
                                            Command="{StaticResource OutputConfigurationCommand}"
                                            CommandParameter="{x:Bind}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">

                                            <AnimatedIcon>
                                                <AnimatedIcon.Source>
                                                    <animatedvisuals:AnimatedSettingsVisualSource />
                                                </AnimatedIcon.Source>
                                                <AnimatedIcon.FallbackIconSource>
                                                    <FontIconSource Glyph="&#xE713;" />
                                                </AnimatedIcon.FallbackIconSource>
                                            </AnimatedIcon>

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('OutputConfiguration')}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </NavigationView>

        <!--  操作栏  -->
        <Grid
            Grid.Row="1"
            Padding="10,5,24,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource ContentDialogBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    ColumnSpacing="5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE8CB;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="SortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[0]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[0]}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('NotSort')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="SortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[1]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[1]}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortByFileName')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="SortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[2]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[2]}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortByFileSize')}" />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortRuleClicked}"
                                    GroupName="SortRuleGroup"
                                    IsChecked="{x:Bind x:Object.Equals(SelectedSortRule, SortRuleList[3]), Mode=OneWay}"
                                    Tag="{x:Bind SortRuleList[3]}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortByDuration')}" />

                                <MenuFlyoutSeparator />

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortWayClicked}"
                                    GroupName="SortWayGroup"
                                    IsChecked="{x:Bind SortWay, Mode=OneWay}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortIncrease')}">

                                    <RadioMenuFlyoutItem.Tag>
                                        <x:Boolean>True</x:Boolean>
                                    </RadioMenuFlyoutItem.Tag>
                                </RadioMenuFlyoutItem>

                                <RadioMenuFlyoutItem
                                    Click="{x:Bind OnSortWayClicked}"
                                    GroupName="SortWayGroup"
                                    IsChecked="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(SortWay), Mode=OneWay}"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('SortDecrease')}">

                                    <RadioMenuFlyoutItem.Tag>
                                        <x:Boolean>False</x:Boolean>
                                    </RadioMenuFlyoutItem.Tag>
                                </RadioMenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Sort')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="{x:Bind OnClearListClicked}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE711;" />

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('ClearList')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE710;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Click="{x:Bind OnAddFileClicked}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddFile')}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem Click="{x:Bind OnAddFromFolderClicked}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddFromFolder')}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Add')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="3"
                        Width="32"
                        Height="32"
                        Padding="7"
                        Click="{x:Bind OnOutputConfigurationClicked}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <AnimatedIcon x:Name="SearchAnimatedIcon">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Find" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('OutputConfiguration')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('OutputFolder')}" />

                    <TextBox
                        Grid.Column="1"
                        Width="350"
                        IsReadOnly="True"
                        Text="{x:Bind OutputFolder, Mode=OneWay}"
                        TextWrapping="NoWrap">

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind OutputFolder, Mode=OneWay}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBox>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />

                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="AppCache"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AppCacheFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xECAA;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Download"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('DownloadFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE896;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Desktop"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('DesktopFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    Click="{x:Bind OnChangeOutputFolderClicked}"
                                    Tag="Custom"
                                    Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Custom')}" />
                            </MenuFlyout>
                        </Button.Flyout>

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('ChangeOutputFolder')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>
            </Grid>

            <Button
                Grid.Column="1"
                MinWidth="100"
                HorizontalAlignment="Stretch"
                Click="{x:Bind OnOkClicked}"
                Content="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('OK')}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
