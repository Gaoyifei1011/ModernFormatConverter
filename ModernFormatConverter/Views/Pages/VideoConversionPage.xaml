<Page
    x:Class="ModernFormatConverter.Views.Pages.VideoConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:class="using:ModernFormatConverter.Extensions.DataType.Class"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:datatemplate="using:ModernFormatConverter.Views.DataTemplates"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ModernFormatConverter.Models"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">1,0,0,0</Thickness>
            <Thickness x:Key="NavigationViewContentMargin">6,0,0,0</Thickness>
            <Thickness x:Key="NavigationViewPaneContentGridMargin">-1,10,0,3</Thickness>

            <class:ExecuteCommand x:Name="RemoveCommand" ExecuteRequested="{x:Bind OnRemoveExecuteRequested}" />
            <class:ExecuteCommand x:Name="OutputConfigurationCommand" ExecuteRequested="{x:Bind OnOutputConfigurationExecuteRequested}" />
            <class:ExecuteCommand x:Name="CutVideoCommand" ExecuteRequested="{x:Bind OnCutVideoExecuteRequested}" />

            <DataTemplate x:Key="VideoCardDataTemplate" x:DataType="model:VideoConversionFileModel">
                <!--  视频转换卡片数据模板  -->
                <Grid
                    Height="100"
                    Margin="16,0,12,5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Width="120"
                        Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">

                        <Image Grid.Column="0" Source="{x:Bind FileThumbnailSource, Mode=OneWay}" />
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        RowSpacing="5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind FileName}"
                            TextLineBounds="TrimToCapHeight"
                            TextWrapping="NoWrap">

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent"
                                    Visibility="{Binding ElementName=DescriptionText, Path=IsTextTrimmed, Mode=OneWay}">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind FilePath}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </TextBlock>

                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis">

                            <Run Text="{x:Bind FileSizeString}" />
                            <Run Text=" | " />
                            <Run Text="{x:Bind DurationString}" />
                            <Run Text=" | " />
                            <Run Text="{x:Bind ScreenSizeWidth}" /><Run Text="x" /><Run Text="{x:Bind ScreenSizeHeight}" />
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="2" Margin="5,0,20,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{StaticResource CutVideoCommand}"
                            CommandParameter="{x:Bind}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind converter:ValueCheckConverterHelper.GetIsVideoFormatCovnersion(VideoConversionOutputConfiguration)}">

                            <FontIcon FontSize="16" Glyph="&#xE8C6;" />

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('CutVideo')}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Margin="5,0,0,0"
                            Padding="7"
                            Command="{StaticResource OutputConfigurationCommand}"
                            CommandParameter="{x:Bind}"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <AnimatedIcon>
                                <AnimatedIcon.Source>
                                    <animatedvisuals:AnimatedSettingsVisualSource />
                                </AnimatedIcon.Source>
                                <AnimatedIcon.FallbackIconSource>
                                    <FontIconSource Glyph="&#xE713;" />
                                </AnimatedIcon.FallbackIconSource>
                            </AnimatedIcon>

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('OutputConfiguration')}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Margin="5,0,0,0"
                            Padding="0"
                            Command="{StaticResource RemoveCommand}"
                            CommandParameter="{x:Bind}"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <FontIcon FontSize="16" Glyph="&#xE894;" />

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Remove')}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!--  视频转换列表数据模板  -->
            <DataTemplate x:Key="VideoListDataTemplate" x:DataType="model:VideoConversionFileModel">
                <Grid
                    Height="35"
                    Margin="16,0,16,0"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="FileNameText"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{x:Bind FileName}"
                        TextAlignment="Left"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{Binding ElementName=FileNameText, Path=IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind FilePath}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>

                    <TextBlock
                        x:Name="FileSizeText"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{x:Bind FileSizeString}"
                        TextAlignment="Left"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{Binding ElementName=FileSizeText, Path=IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind FileSizeString}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>

                    <TextBlock
                        x:Name="DurationText"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{x:Bind DurationString}"
                        TextAlignment="Left"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{Binding ElementName=DurationText, Path=IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind DurationString}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>

                    <TextBlock
                        x:Name="ScreenSizeText"
                        Grid.Column="3"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="14"
                        TextAlignment="Left"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">

                        <Run Text="{x:Bind ScreenSizeWidth}" /><Run Text="x" /><Run Text="{x:Bind ScreenSizeHeight}" />

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Visibility="{Binding ElementName=ScreenSizeText, Path=IsTextTrimmed, Mode=OneWay}">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}">
                                        <Run Text="{x:Bind ScreenSizeWidth}" /><Run Text="x" /><Run Text="{x:Bind ScreenSizeHeight}" />
                                    </TextBlock>
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>

                    <HyperlinkButton
                        Grid.Column="4"
                        Margin="10,0,0,0"
                        Padding="0"
                        Command="{StaticResource RemoveCommand}"
                        CommandParameter="{x:Bind}"
                        Content="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Remove')}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            Grid.Row="0"
            Margin="10,0,0,0"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemsSource="{x:Bind VideoConversionTypeCollection}"
            OpenPaneLength="300"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind SelectedConversionType, Mode=OneWay}"
            SelectionChanged="{x:Bind OnSelectionChanged}">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="model:VideoConversionTypeModel">
                    <NavigationViewItem>
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind VideoConversionIcon}" />
                        </NavigationViewItem.Icon>

                        <TextBlock
                            x:Name="VideoConversionTypeText"
                            Text="{x:Bind VideoConversionType}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap">

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent"
                                    Visibility="{Binding ElementName=VideoConversionTypeText, Path=IsTextTrimmed, Mode=OneWay}">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind VideoConversionType}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <NavigationView.MenuItemContainerStyle>
                <Style BasedOn="{StaticResource NavigationViewItemStyle}" TargetType="NavigationViewItem">
                    <Setter Property="IsEnabled" Value="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsGettingFileInformation), Mode=OneWay}" />
                </Style>
            </NavigationView.MenuItemContainerStyle>

            <Grid
                AllowDrop="{x:Bind GetAllowDropVideoConversionFile(SelectedConversionType.VideoConversionTypeKind), Mode=OneWay}"
                Background="Transparent"
                DragEnter="{x:Bind OnVideoConversionDragEnter}"
                Drop="{x:Bind OnVideoConversionDrop}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="30,15,30,5"
                    FontSize="22"
                    Text="{x:Bind SelectedConversionType.VideoConversionType, Mode=OneWay}" />

                <!--  正在加载文件信息中  -->
                <Grid
                    Grid.Row="1"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="2"
                    ColumnSpacing="10"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind IsGettingFileInformation, Mode=OneWay}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressRing
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        IsActive="{x:Bind IsGettingFileInformation, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('GettingFileInformation')}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Row="1" Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsGettingFileInformation), Mode=OneWay}">

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        Visibility="{x:Bind converter:ValueCheckConverterHelper.GetVideoConversionType(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow, x:False), Mode=OneWay}">

                        <!--  视频混流控件  -->
                        <Grid Margin="32,0,24,30" RowSpacing="5">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontSize="16"
                                Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('VideoSection')}" />

                            <!--  视频文件添加信息提示按钮  -->
                            <Grid
                                Grid.Row="1"
                                Height="100"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AllowDrop="{x:Bind x:Object.Equals(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow), Mode=OneWay}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                DragEnter="{x:Bind OnVideoMixedFlowDragEnter}"
                                Drop="{x:Bind OnVideoMixedFlowVideoDrop}"
                                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(SelectedConversionType.VideoMixedFlow.IsVideoFileExisted), Mode=OneWay}">

                                <Grid Canvas.ZIndex="1">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('DragAddVideoFileTip')}" />

                                    <Button
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Click="{x:Bind OnAddVideoFileClicked}"
                                        Content="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddVideoFile')}" />
                                </Grid>

                                <Rectangle
                                    Canvas.ZIndex="0"
                                    Fill="Transparent"
                                    RadiusX="4"
                                    RadiusY="4"
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeDashArray="5,2"
                                    StrokeThickness="1" />
                            </Grid>

                            <!--  视频文件信息控件  -->
                            <Grid
                                Grid.Row="1"
                                Height="100"
                                Margin="0,0,0,5"
                                AllowDrop="{x:Bind x:Object.Equals(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow), Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                DragEnter="{x:Bind OnVideoMixedFlowDragEnter}"
                                Drop="{x:Bind OnVideoMixedFlowVideoDrop}"
                                Visibility="{x:Bind SelectedConversionType.VideoMixedFlow.IsVideoFileExisted, Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Grid.Column="0"
                                    Width="120"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,1,0">

                                    <Image Grid.Column="0" Source="{x:Bind SelectedConversionType.VideoMixedFlow.VideoFile.FileThumbnailSource, Mode=OneWay}" />
                                </Grid>

                                <Grid
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    RowSpacing="5">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind SelectedConversionType.VideoMixedFlow.VideoFile.FileName, Mode=OneWay}"
                                        TextLineBounds="TrimToCapHeight"
                                        TextWrapping="NoWrap">

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind SelectedConversionType.VideoMixedFlow.VideoFile.FilePath, Mode=OneWay}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </TextBlock>

                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis">

                                        <Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.VideoFile.FileSize, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.VideoFile.Duration, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.VideoFile.ScreenSizeWidth, Mode=OneWay}" /><Run Text="x" /><Run Text="{x:Bind SelectedConversionType.VideoMixedFlow.VideoFile.ScreenSizeHeight, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0,20,0"
                                    Padding="0"
                                    Click="{x:Bind OnRemoveVideoMixedFlowVideoFileClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE894;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('Remove')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <TextBlock
                                Grid.Row="2"
                                FontSize="16"
                                Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AudioSection')}" />

                            <!--  音频文件添加信息提示按钮  -->
                            <Grid
                                Grid.Row="3"
                                Height="100"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AllowDrop="{x:Bind x:Object.Equals(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow), Mode=OneWay}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                DragEnter="{x:Bind OnVideoMixedFlowDragEnter}"
                                Drop="{x:Bind OnVideoMixedFlowAudioDrop}"
                                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(SelectedConversionType.VideoMixedFlow.IsAudioFileExisted), Mode=OneWay}">

                                <Grid Canvas.ZIndex="1">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Text="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('DragAddAudioFileTip')}" />

                                    <Button
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Click="{x:Bind OnAddAudiofileClicked}"
                                        Content="{x:Bind rootservice:ResourceService.VideoConversionResource.GetString('AddAudioFile')}" />
                                </Grid>

                                <Rectangle
                                    Canvas.ZIndex="0"
                                    Fill="Transparent"
                                    RadiusX="4"
                                    RadiusY="4"
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeDashArray="5,2"
                                    StrokeThickness="1" />
                            </Grid>

                            <!--  音频文件信息控件  -->
                            <Grid
                                Grid.Row="3"
                                Height="100"
                                Margin="0,0,0,5"
                                AllowDrop="{x:Bind x:Object.Equals(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoMixedFlow), Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                DragEnter="{x:Bind OnVideoMixedFlowDragEnter}"
                                Drop="{x:Bind OnVideoMixedFlowAudioDrop}"
                                Visibility="{x:Bind SelectedConversionType.VideoMixedFlow.IsAudioFileExisted, Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Grid.Column="0"
                                    Width="120"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,1,0">

                                    <Image Grid.Column="0" Source="{x:Bind SelectedConversionType.VideoMixedFlow.AudioFile.FileThumbnailSource, Mode=OneWay}" />
                                </Grid>

                                <Grid
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    RowSpacing="5">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind SelectedConversionType.VideoMixedFlow.AudioFile.FileName, Mode=OneWay}"
                                        TextLineBounds="TrimToCapHeight"
                                        TextWrapping="NoWrap">

                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                MaxWidth="9999"
                                                Padding="0"
                                                Background="Transparent">

                                                <Grid>
                                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind SelectedConversionType.VideoMixedFlow.AudioFile.FilePath, Mode=OneWay}" />
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </TextBlock>

                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
