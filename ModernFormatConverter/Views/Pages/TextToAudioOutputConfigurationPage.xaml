<Page
    x:Class="ModernFormatConverter.Views.Pages.TextToAudioOutputConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    NavigationCacheMode="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  文本转语音输出配置控制栏  -->
        <Grid Grid.Row="0" Margin="16,0,30,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <SelectorBar
                x:Name="TextToAudioOutputConfigurationSelectorBar"
                Grid.Column="0"
                Margin="-8,-4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                SelectedItem="{x:Bind SelectedItem, Mode=OneWay}">

                <SelectorBarItem Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('OutputConfiguration')}" />
            </SelectorBar>

            <Grid
                Grid.Column="1"
                Margin="10,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Margin="0,0,5,0"
                    Padding="7"
                    Click="{x:Bind OnSystemSettingsClicked}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('SystemSettings')}">

                    <AnimatedIcon>
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedSettingsVisualSource />
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <FontIconSource Glyph="&#xE713;" />
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                </Button>

                <Button
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="{x:Bind OnOkClicked}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('OK')}">

                    <FontIcon FontSize="14" Glyph="&#xE8FB;" />
                </Button>
            </Grid>
        </Grid>

        <MenuFlyoutSeparator Grid.Row="1" Margin="21,0,34,3" />

        <ScrollViewer
            Grid.Row="2"
            Padding="16,0,30,3"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            Visibility="{x:Bind IsVoiceExisted, Mode=OneWay}">

            <StackPanel>
                <!--  语音类型  -->
                <Grid
                    Height="60"
                    Margin="0,0,0,2"
                    Padding="16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('VoiceType')}" />

                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        DisplayMemberPath="DisplayMember"
                        ItemsSource="{x:Bind VoiceTypeList}"
                        SelectedItem="{x:Bind SelectedVoiceType, Mode=OneWay}"
                        SelectionChanged="{x:Bind OnSelectedVoiceTypeSelectionChanged}"
                        Style="{StaticResource ComboBoxStyle}" />
                </Grid>

                <!--  阅读速率  -->
                <Grid
                    Height="60"
                    Margin="0,0,0,2"
                    Padding="16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('ReadingSpeed')}" />

                    <Slider
                        Grid.Column="1"
                        Width="200"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="10"
                        Minimum="-10"
                        SmallChange="1"
                        StepFrequency="1"
                        ValueChanged="{x:Bind OnReadingSpeedValueChanged}"
                        Value="{x:Bind ReadingSpeed, Mode=OneWay}" />
                </Grid>

                <!--  音量  -->
                <Grid
                    Height="60"
                    Margin="0,0,0,2"
                    Padding="16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('Volume')}" />

                    <Slider
                        Grid.Column="1"
                        Width="200"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="1"
                        StepFrequency="1"
                        ValueChanged="{x:Bind OnVolumeValueChanged}"
                        Value="{x:Bind Volume, Mode=OneWay}" />
                </Grid>

                <!--  输出文件路径设置  -->
                <Grid
                    Grid.Row="0"
                    Height="60"
                    Margin="0,0,0,2"
                    Padding="16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Vertical">

                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('OutputFolder')}" />

                        <TextBlock
                            HorizontalAlignment="Left"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap">

                            <Hyperlink Click="{x:Bind OnOpenOutputFolderClicked}" UnderlineStyle="None">
                                <Run Text="{x:Bind OutputFolder, Mode=OneWay}" />
                            </Hyperlink>

                            <ToolTipService.ToolTip>
                                <ToolTip>
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('FileStoragePath')}" />
                                        <TextBlock Text="{x:Bind OutputFolder, Mode=OneWay}" />
                                        <MenuFlyoutSeparator Margin="4,3" />
                                        <TextBlock Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('OpenFolder')}" />
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <DropDownButton
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Content="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetObject('ChangeFolder')}">

                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Click="{x:Bind OnOutputChangeFolderClicked}"
                                    Tag="AppCache"
                                    Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('AppCacheFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xECAA;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnOutputChangeFolderClicked}"
                                    Tag="Music"
                                    Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('MusicFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8D6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnOutputChangeFolderClicked}"
                                    Tag="Desktop"
                                    Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('DesktopFolder')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    Click="{x:Bind OnOutputChangeFolderClicked}"
                                    Tag="Custom"
                                    Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('Custom')}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="3"
            Margin="0,0,30,0"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Canvas.ZIndex="2"
            ColumnSpacing="10"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsVoiceExisted), Mode=OneWay}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,0,10"
                VerticalAlignment="Center"
                FontSize="20"
                Text="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('SystemVoiceEmpty')}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                Grid.Row="1"
                HorizontalAlignment="Center"
                Click="{x:Bind OnSystemSettingsClicked}"
                Content="{x:Bind rootservice:ResourceService.TextToAudioOutputConfigurationResource.GetString('SystemSettings')}" />
        </Grid>
    </Grid>
</Page>
