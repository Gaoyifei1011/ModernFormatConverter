                                        Height="35"
                                        Padding="6,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="HATestNameText"
                                            Grid.Column="0"
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind HATestName}"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Visibility="{Binding ElementName=HATestNameText, Path=IsTextTrimmed, Mode=OneWay}">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind HATestName}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotTest')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotTest), Mode=OneWay}" />

                                        <Grid
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Testing), Mode=OneWay}">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressRing
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Testing')}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind HATestFailedReason, Mode=OneWay}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Failed), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Support')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Supported), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotSupport')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotSupported), Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>

                    <!--  英伟达硬件加速测试  -->
                    <Expander
                        Grid.Row="2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        IsExpanded="True">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE770;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NvidiaHATest')}" />
                            </Grid>
                        </Expander.Header>

                        <ListView
                            CornerRadius="0"
                            ItemsSource="{x:Bind NvidiaHATestCollection}"
                            SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:HATestModel">
                                    <Grid
                                        Height="35"
                                        Padding="6,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="HATestNameText"
                                            Grid.Column="0"
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind HATestName}"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Visibility="{Binding ElementName=HATestNameText, Path=IsTextTrimmed, Mode=OneWay}">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind HATestName}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotTest')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotTest), Mode=OneWay}" />

                                        <Grid
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Testing), Mode=OneWay}">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressRing
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Testing')}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind HATestFailedReason, Mode=OneWay}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Failed), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Support')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Supported), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotSupport')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotSupported), Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>

                    <!--  AMD 硬件加速测试  -->
                    <Expander
                        Grid.Row="3"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        IsExpanded="True">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE770;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('AMDHATest')}" />
                            </Grid>
                        </Expander.Header>

                        <ListView
                            CornerRadius="0"
                            ItemsSource="{x:Bind AMDHATestCollection}"
                            SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:HATestModel">
                                    <Grid
                                        Height="35"
                                        Padding="6,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="HATestNameText"
                                            Grid.Column="0"
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind HATestName}"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Visibility="{Binding ElementName=HATestNameText, Path=IsTextTrimmed, Mode=OneWay}">

                                                    <Grid>
                                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind HATestName}" />
                                                    </Grid>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotTest')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotTest), Mode=OneWay}" />

                                        <Grid
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Testing), Mode=OneWay}">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressRing
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Testing')}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind HATestFailedReason, Mode=OneWay}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Failed), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Support')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Supported), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotSupport')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotSupported), Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>

        <SplitView.Pane>
            <!--  使用说明  -->
            <Grid Margin="0,10,0,0" CornerRadius="4,0,0,0">
                <SystemBackdropElement CornerRadius="4,0,0,0" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="16,2,6,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Glyph="&#xE946;" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('UseInstruction')}" />

                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="{x:Bind OnCloseClicked}"
                            Style="{StaticResource AlternateCloseButtonStyle}">

                            <FontIcon
                                Margin="4"
                                FontSize="16"
                                Glyph="&#xE711;" />

                            <ToolTipService.ToolTip>
                                <ToolTip
                                    MaxWidth="9999"
                                    Padding="0"
                                    Background="Transparent">

                                    <Grid>
                                        <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                        <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Close')}" />
                                    </Grid>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Visible"
                        VerticalScrollMode="Enabled">

                        <Grid Margin="0,0,0,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="16,10,16,10"
                                FontSize="15"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('HATestInstruction')}"
                                TextAlignment="Left" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('HATestInstructionContent1')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('HATestInstructionContent2')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Grid.Row="3"
                                Margin="16,0,16,5"
                                Spacing="5">

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink Click="{x:Bind OnOpenDeviceManagementClicked}" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('OpenDeviceManagement')}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink NavigateUri="https://www.intel.com/content/www/us/en/download-center/home.html" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('DownloadIntelGPUDriver')}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink NavigateUri="https://www.nvidia.com/drivers" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('DownloadNvidiaGPUDriver')}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink NavigateUri="https://www.amd.com/en/support/download/drivers.html" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('DownloadAMDGPUDriver')}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </SplitView.Pane>
    </SplitView>
</Page>
