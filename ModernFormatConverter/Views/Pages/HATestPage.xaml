<Page
    x:Class="ModernFormatConverter.Views.Pages.HATestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:backdrophelper="using:ModernFormatConverter.Helpers.Backdrop"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ModernFormatConverter.Models"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="30,15,30,0"
            FontSize="22"
            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('HATest')}" />

        <!--  硬件加速测试控制栏  -->
        <Grid
            Grid.Row="1"
            Height="60"
            Margin="30,0,30,3"
            Padding="18,0,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Margin="0,0,12,0"
                FontSize="16"
                Glyph="&#xE74C;" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Operation')}" />

            <CommandBar
                Grid.Column="2"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right">

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnRunHATestClicked}"
                        Label="{x:Bind rootservice:ResourceService.HATestResource.GetString('RunHATest')}"
                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsTesting), Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnStopHATestClicked}"
                        Label="{x:Bind rootservice:ResourceService.HATestResource.GetString('StopHATest')}"
                        Visibility="{x:Bind IsTesting, Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71A;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>

            <Button
                Grid.Column="3"
                MinHeight="{ThemeResource AppBarThemeCompactHeight}"
                Margin="-6,0,0,0"
                Padding="{ThemeResource CommandBarMoreButtonMargin}"
                VerticalAlignment="Center"
                Foreground="{ThemeResource CommandBarForeground}"
                IsAccessKeyScope="True"
                Style="{ThemeResource EllipsisButton}">

                <Button.Content>
                    <FontIcon
                        Height="{ThemeResource AppBarExpandButtonCircleDiameter}"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Glyph="&#xE712;" />
                </Button.Content>

                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Click="{x:Bind OnUseInstructionClicked}" Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('UseInstruction')}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>

                <ToolTipService.ToolTip>
                    <ToolTip
                        MaxWidth="9999"
                        Content="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('ViewMore')}"
                        Loaded="{x:Bind backdrophelper:ToolTipBackdropHelper.OnLoaded}" />
                </ToolTipService.ToolTip>
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">

            <Grid Margin="30,0,30,30" RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  英特尔硬件加速测试  -->
                <Expander
                    Grid.Row="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsExpanded="True">

                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                FontSize="16"
                                Glyph="&#xE770;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('IntelHATest')}" />
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <ListView
                            CornerRadius="0"
                            ItemsSource="{x:Bind IntelHATestCollection}"
                            SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:HATestModel">
                                    <Grid
                                        Height="35"
                                        Padding="6,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="HATestNameText"
                                            Grid.Column="0"
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="{x:Bind HATestName}"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Background="Transparent"
                                                    Content="{x:Bind HATestName}"
                                                    Loaded="{x:Bind backdrophelper:ToolTipBackdropHelper.OnLoaded}"
                                                    Visibility="{Binding ElementName=HATestNameText, Path=IsTextTrimmed, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotTest')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotTest), Mode=OneWay}" />

                                        <Grid
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Testing), Mode=OneWay}">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressRing
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Testing')}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind HATestFailedReason, Mode=OneWay}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Failed), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Support')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Supported), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotSupport')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotSupported), Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander.Content>
                </Expander>

                <!--  媒体基础硬件加速测试  -->
                <Expander
                    Grid.Row="1"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsExpanded="True">

                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                FontSize="16"
                                Glyph="&#xE770;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('MediaFoundationTest')}" />
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <ListView
                            CornerRadius="0"
                            ItemsSource="{x:Bind MediaFoundationTestCollection}"
                            SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:HATestModel">
                                    <Grid
                                        Height="35"
                                        Padding="6,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="HATestNameText"
                                            Grid.Column="0"
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind HATestName}"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Background="Transparent"
                                                    Content="{x:Bind HATestName}"
                                                    Loaded="{x:Bind backdrophelper:ToolTipBackdropHelper.OnLoaded}"
                                                    Visibility="{Binding ElementName=HATestNameText, Path=IsTextTrimmed, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotTest')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotTest), Mode=OneWay}" />

                                        <Grid
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Testing), Mode=OneWay}">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressRing
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Testing')}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind HATestFailedReason, Mode=OneWay}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Failed), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Support')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Supported), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotSupport')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotSupported), Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander.Content>
                </Expander>

                <!--  英伟达硬件加速测试  -->
                <Expander
                    Grid.Row="2"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsExpanded="True">

                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                FontSize="16"
                                Glyph="&#xE770;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NvidiaHATest')}" />
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <ListView
                            CornerRadius="0"
                            ItemsSource="{x:Bind NvidiaHATestCollection}"
                            SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:HATestModel">
                                    <Grid
                                        Height="35"
                                        Padding="6,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="HATestNameText"
                                            Grid.Column="0"
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind HATestName}"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Background="Transparent"
                                                    Content="{x:Bind HATestName}"
                                                    Loaded="{x:Bind backdrophelper:ToolTipBackdropHelper.OnLoaded}"
                                                    Visibility="{Binding ElementName=HATestNameText, Path=IsTextTrimmed, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotTest')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotTest), Mode=OneWay}" />

                                        <Grid
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Testing), Mode=OneWay}">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressRing
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Testing')}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind HATestFailedReason, Mode=OneWay}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Failed), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Support')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Supported), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotSupport')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotSupported), Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander.Content>
                </Expander>

                <!--  AMD 硬件加速测试  -->
                <Expander
                    Grid.Row="3"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsExpanded="True">

                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                FontSize="16"
                                Glyph="&#xE770;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('AMDHATest')}" />
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <ListView
                            CornerRadius="0"
                            ItemsSource="{x:Bind AMDHATestCollection}"
                            SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:HATestModel">
                                    <Grid
                                        Height="35"
                                        Padding="6,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="HATestNameText"
                                            Grid.Column="0"
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind HATestName}"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip
                                                    MaxWidth="9999"
                                                    Background="Transparent"
                                                    Content="{x:Bind HATestName}"
                                                    Loaded="{x:Bind backdrophelper:ToolTipBackdropHelper.OnLoaded}"
                                                    Visibility="{Binding ElementName=HATestNameText, Path=IsTextTrimmed, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotTest')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotTest), Mode=OneWay}" />

                                        <Grid
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Testing), Mode=OneWay}">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressRing
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Testing')}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind HATestFailedReason, Mode=OneWay}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Failed), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('Support')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.Supported), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('NotSupport')}"
                                            Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckHATestResultKind(HATestResultKind, enum:HATestResultKind.NotSupported), Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander.Content>
                </Expander>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
