<Page
    x:Class="ModernFormatConverter.Views.Pages.PhotoConversionOutputConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ModernFormatConverter.Views.Controls"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    xmlns:system="using:System"
    xmlns:valueconverter="using:ModernFormatConverter.Views.ValueConveters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ResourceDictionary>
            <valueconverter:SliderThumbnailToolTipValueConverter x:Name="SliderThumbnailToolTipValueConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!--  图片输出配置控件  -->
        <Grid Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsCroppingImage), Mode=OneWay}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  图片格式转换配置控制栏  -->
            <Grid Grid.Row="0" Margin="16,0,30,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <SelectorBar
                    x:Name="PhotoConversionOutputConfigurationSelectorBar"
                    Grid.Column="0"
                    Margin="-8,-4,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SelectedItem="{x:Bind SelectedItem, Mode=OneWay}">

                    <SelectorBarItem Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Photo')}" />
                </SelectorBar>

                <Grid
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,5,0"
                        Padding="0"
                        Click="{x:Bind OnPreviewPhotoClicked}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind GetIsPreviewPhotoEnabled(IsGlobalSettings, AdjustPhoto), Mode=OneWay}">

                        <FontIcon FontSize="14" Glyph="&#xE8FF;" />

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('PreviewPhoto')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="{x:Bind OnOkClicked}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Style="{StaticResource AccentButtonStyle}">

                        <FontIcon FontSize="14" Glyph="&#xE8FB;" />

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent">

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                    <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.AudioConversionOutputConfigurationResource.GetString('OK')}" />
                                </Grid>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>
            </Grid>

            <MenuFlyoutSeparator Grid.Row="1" Margin="21,0,34,3" />

            <ScrollViewer
                Grid.Row="2"
                Padding="16,0,30,3"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">

                <StackPanel Margin="0,0,0,30">
                    <TextBlock
                        x:Name="PhotoHeader"
                        Margin="2,0,0,5"
                        FontSize="16"
                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Photo')}" />

                    <!--  格式转换类型  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('FormatConversionType')}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="DisplayMember"
                            ItemsSource="{x:Bind FormatConversionTypeList}"
                            SelectedItem="{x:Bind SelectedFormatConversionType, Mode=OneWay}"
                            SelectionChanged="{x:Bind OnFormatConversionTypeSelectionChanged}"
                            Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <!--  图片选项  -->
                    <Expander
                        Margin="0,0,0,2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        IsExpanded="True"
                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsGlobalSettings), Mode=OneWay}">

                        <Expander.Header>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('PhotoOptions')}" />
                        </Expander.Header>

                        <StackPanel Padding="0">
                            <!--  裁剪图片  -->
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ColumnSpacing="5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('CutImage')}" />

                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind IsImageCropped, Mode=OneWay}"
                                    OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('CutImageOffContent')}"
                                    OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('CutImageOnContent')}"
                                    Style="{StaticResource ToggleSwitchStyle}"
                                    Toggled="{x:Bind OnImageCroppedToggled}" />

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnCutImageClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <FontIcon FontSize="16" Glyph="&#xE8C6;" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            MaxWidth="9999"
                                            Padding="0"
                                            Background="Transparent">

                                            <Grid>
                                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('CutImage')}" />
                                            </Grid>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <MenuFlyoutSeparator />

                            <!--  图片大小  -->
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ColumnSpacing="5"
                                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageCropped), Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('PhotoSize')}" />

                                <NumberBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="{x:Bind OnImageWidthValueChanged}"
                                    Value="{x:Bind ImageWidth, Mode=OneWay}" />

                                <NumberBox
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    ValueChanged="{x:Bind OnImageHeightValueChanged}"
                                    Value="{x:Bind ImageHeight, Mode=OneWay}" />
                            </Grid>

                            <MenuFlyoutSeparator Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageCropped), Mode=OneWay}" />

                            <!--  锁定比例  -->
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageCropped), Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('LockRatio')}" />

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{x:Bind LockRatio, Mode=OneWay}"
                                    OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('LockRatioOffContent')}"
                                    OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('LockRatioOnContent')}"
                                    Style="{StaticResource ToggleSwitchStyle}"
                                    Toggled="{x:Bind OnLockRatioToggled}" />
                            </Grid>

                            <!--  截取起点坐标  -->
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsImageCropped, Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ClipStartPointPosition')}" />

                                <Grid Grid.Column="1" ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('XCoordinate')}" />

                                    <NumberBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="{x:Bind OnXCoordinateValueChanged}"
                                        Value="{x:Bind XCoordinate, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('YCoordinate')}" />

                                    <NumberBox
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind system:Convert.ToString(YCoordinate), Mode=OneWay}"
                                        ValueChanged="{x:Bind OnYCoordinateValueChanged}" />
                                </Grid>
                            </Grid>

                            <MenuFlyoutSeparator Visibility="{x:Bind IsImageCropped, Mode=OneWay}" />

                            <!--  截取大小  -->
                            <Grid
                                Height="52"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsImageCropped, Mode=OneWay}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ClipSize')}" />

                                <Grid Grid.Column="1" ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ClipWidth')}" />

                                    <NumberBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="{x:Bind OnClipWidthValueChanged}"
                                        Value="{x:Bind ClipWidth, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ClipHeight')}" />

                                    <NumberBox
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        ValueChanged="{x:Bind OnClipHeightValueChanged}"
                                        Value="{x:Bind ClipHeight, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!--  调整图片  -->
                    <Grid
                        Height="60"
                        Margin="0,0,0,2"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="5"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('AdjustPhoto')}" />

                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind AdjustPhoto, Mode=OneWay}"
                            OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('AdjustPhotoOffContent')}"
                            OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('AdjustPhotoOnContent')}"
                            Style="{StaticResource ToggleSwitchStyle}"
                            Toggled="{x:Bind OnAdjustPhotoToggled}" />
                    </Grid>

                    <StackPanel Visibility="{x:Bind AdjustPhoto, Mode=OneWay}">
                        <!--  对比度  -->
                        <Grid
                            Height="60"
                            Margin="0,0,0,2"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="5"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ContrastRatio')}" />

                            <Slider
                                Grid.Column="1"
                                Width="200"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="2"
                                Minimum="0"
                                SmallChange="1"
                                StepFrequency="1"
                                ThumbToolTipValueConverter="{StaticResource SliderThumbnailToolTipValueConverter}"
                                ValueChanged="{x:Bind OnContrastRatioValueChanged}"
                                Value="{x:Bind ContrastRatio, Mode=OneWay}" />

                            <Button
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="{x:Bind OnResetContrastRatioClicked}"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        MaxWidth="9999"
                                        Padding="0"
                                        Background="Transparent">

                                        <Grid>
                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Reset')}" />
                                        </Grid>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <!--  亮度  -->
                        <Grid
                            Height="60"
                            Margin="0,0,0,2"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="5"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Brightness')}" />

                            <Slider
                                Grid.Column="1"
                                Width="200"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.1"
                                StepFrequency="0.1"
                                ThumbToolTipValueConverter="{StaticResource SliderThumbnailToolTipValueConverter}"
                                ValueChanged="{x:Bind OnBrightnessValueChanged}"
                                Value="{x:Bind Brightness, Mode=OneWay}" />

                            <Button
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="{x:Bind OnResetBrightnessClicked}"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        MaxWidth="9999"
                                        Padding="0"
                                        Background="Transparent">

                                        <Grid>
                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Reset')}" />
                                        </Grid>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <!--  饱和度  -->
                        <Grid
                            Height="60"
                            Margin="0,0,0,2"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="5"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Saturation')}" />

                            <Slider
                                Grid.Column="1"
                                Width="200"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="2"
                                Minimum="0"
                                SmallChange="0.01"
                                StepFrequency="0.01"
                                ThumbToolTipValueConverter="{StaticResource SliderThumbnailToolTipValueConverter}"
                                ValueChanged="{x:Bind OnSaturationValueChanged}"
                                Value="{x:Bind Saturation, Mode=OneWay}" />

                            <Button
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="{x:Bind OnResetSaturationClicked}"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        MaxWidth="9999"
                                        Padding="0"
                                        Background="Transparent">

                                        <Grid>
                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Reset')}" />
                                        </Grid>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <!--  色温  -->
                        <Grid
                            Height="60"
                            Margin="0,0,0,2"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="5"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ColorTemperature')}" />

                            <Slider
                                Grid.Column="1"
                                Width="200"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="40000"
                                Minimum="1000"
                                SmallChange="500"
                                StepFrequency="500"
                                ValueChanged="{x:Bind OnColorTemperatureValueChanged}"
                                Value="{x:Bind ColorTemperature, Mode=OneWay}" />

                            <Button
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="{x:Bind OnResetColorTemperatureClicked}"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        MaxWidth="9999"
                                        Padding="0"
                                        Background="Transparent">

                                        <Grid>
                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Reset')}" />
                                        </Grid>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <!--  色调  -->
                        <Grid
                            Height="60"
                            Margin="0,0,0,2"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="5"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Hue')}" />

                            <Slider
                                Grid.Column="1"
                                Width="200"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="30"
                                Minimum="-30"
                                SmallChange="1"
                                StepFrequency="1"
                                ValueChanged="{x:Bind OnHueValueChanged}"
                                Value="{x:Bind Hue, Mode=OneWay}" />

                            <Button
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="{x:Bind OnResetHueClicked}"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        MaxWidth="9999"
                                        Padding="0"
                                        Background="Transparent">

                                        <Grid>
                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Reset')}" />
                                        </Grid>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <!--  模糊  -->
                        <Grid
                            Height="60"
                            Margin="0,0,0,2"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="5"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Blur')}" />

                            <Slider
                                Grid.Column="1"
                                Width="200"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Minimum="0"
                                SmallChange="1"
                                StepFrequency="1"
                                ValueChanged="{x:Bind OnBlurValueChanged}"
                                Value="{x:Bind Blur, Mode=OneWay}" />

                            <Button
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="{x:Bind OnResetBlurClicked}"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <FontIcon FontSize="16" Glyph="&#xE7A7;" />

                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        MaxWidth="9999"
                                        Padding="0"
                                        Background="Transparent">

                                        <Grid>
                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.PhotoConversionResource.GetString('Reset')}" />
                                        </Grid>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <!--  灰度  -->
                        <Grid
                            Height="60"
                            Margin="0,0,0,2"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="5"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('GrayScale')}" />

                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind GrayScale, Mode=OneWay}"
                                OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('GrayScaleOffContent')}"
                                OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('GrayScaleOnContent')}"
                                Style="{StaticResource ToggleSwitchStyle}"
                                Toggled="{x:Bind OnGrayScaleToggled}" />
                        </Grid>

                        <!--  反相  -->
                        <Grid
                            Height="60"
                            Margin="0,0,0,2"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="5"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Reversal')}" />

                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind Reversal, Mode=OneWay}"
                                OffContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ReversalOffContent')}"
                                OnContent="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('ReversalOnContent')}"
                                Style="{StaticResource ToggleSwitchStyle}"
                                Toggled="{x:Bind OnReversalToggled}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  裁剪图片控件  -->
        <Grid Margin="16,0,0,0" Visibility="{x:Bind IsCroppingImage, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:ImageCropper
                x:Name="PhotoConversionOutputConfigurationImageCropper"
                Grid.Row="0"
                CropSizeChanged="{x:Bind OnCropSizeChanged}" />

            <Grid
                Grid.Row="1"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                ColumnSpacing="5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0">
                    <Run Text="(" /><Run Text="{x:Bind ClipedXCoordinate, Mode=OneWay}" /><Run Text="," />
                    <Run Text="{x:Bind ClipedYCoordinate, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>

                <TextBlock Grid.Column="1">
                    <Run Text="{x:Bind ClipedWidth, Mode=OneWay}" /><Run Text=" x " /><Run Text="{x:Bind ClipedHeight, Mode=OneWay}" />
                </TextBlock>
            </Grid>

            <StackPanel
                Grid.Row="1"
                Margin="0,5"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">

                <ComboBox
                    VerticalAlignment="Center"
                    DisplayMemberPath="DisplayMember"
                    ItemsSource="{x:Bind AspectRatioList}"
                    SelectedItem="{x:Bind SelectedAspectRatio, Mode=OneWay}"
                    SelectionChanged="{x:Bind OnAspectRatioSelectionChanged}"
                    Style="{StaticResource ComboBoxStyle}" />

                <Button
                    Click="{x:Bind OnImageClipOkClicked}"
                    Content="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('OK')}"
                    Style="{StaticResource AccentButtonStyle}" />

                <Button Click="{x:Bind OnImageClipCancelClicked}" Content="{x:Bind rootservice:ResourceService.PhotoConversionOutputConfigurationResource.GetString('Cancel')}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
