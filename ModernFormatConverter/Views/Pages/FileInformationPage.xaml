<Page
    x:Class="ModernFormatConverter.Views.Pages.FileInformationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:local="using:ModernFormatConverter.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    AllowDrop="True"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="30,15,30,0"
            FontSize="22"
            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileInformation')}" />

        <!--  文件信息控制栏  -->
        <Grid
            Grid.Row="1"
            Height="60"
            Margin="30,5,30,3"
            Padding="18,0,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Margin="0,0,12,0"
                FontSize="16"
                Glyph="&#xE74C;" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Operation')}" />

            <CommandBar
                Grid.Column="2"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right">

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnOpenFileClicked}"
                        IsEnabled="{x:Bind GetIsParsing(FileInformationResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('OpenFile')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>
        </Grid>

        <!--  文件未解析信息栏  -->
        <Grid
            Grid.Row="2"
            Height="60"
            Margin="30,0,30,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind GetFileInformationSuccessfullyState(FileInformationResultKind, x:False), Mode=OneWay}">

            <Grid>
                <!--  未解析文件  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileNotParse')}"
                    TextAlignment="Center"
                    Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.NotParse), Mode=OneWay}" />

                <!--  解析文件失败  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Bind FileInformationFailedContent, Mode=OneWay}"
                    TextAlignment="Center"
                    Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.Failed), Mode=OneWay}" />
            </Grid>
        </Grid>

        <!--  文件详细信息  -->
        <Grid Grid.Row="3" Visibility="{x:Bind GetFileInformationSuccessfullyState(FileInformationResultKind, x:True), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Margin="40,0,10,0"
                VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Source="{x:Bind FileThumbnailImage, Mode=OneWay}" />

                <Button
                    Grid.Row="1"
                    Margin="0,0,0,3"
                    HorizontalAlignment="Stretch"
                    Click="{x:Bind OnFilePropertiesClicked}"
                    Content="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileProperties')}" />

                <Button
                    Grid.Row="2"
                    Margin="0,0,0,3"
                    HorizontalAlignment="Stretch"
                    Click="{x:Bind OnOpenFileLocationClicked}"
                    Content="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileLocation')}" />

                <Button
                    Grid.Row="3"
                    HorizontalAlignment="Stretch"
                    Click="{x:Bind OnCopyClipboardClicked}"
                    Content="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('CopyClipboard')}" />
            </Grid>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Visible"
                VerticalScrollMode="Enabled">

                <Grid Margin="0,0,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                    </Grid.RowDefinitions>

                    <Expander
                        Grid.Row="0"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE946;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('GeneralInformation')}" />
                            </Grid>
                        </Expander.Header>
                    </Expander>

                    <Expander
                        Grid.Row="1"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.VideoFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE714;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('VideoInformation')}" />
                            </Grid>
                        </Expander.Header>
                    </Expander>

                    <Expander
                        Grid.Row="2"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.MusicFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8D6;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('AudioInformation')}" />
                            </Grid>
                        </Expander.Header>
                    </Expander>

                    <Expander
                        Grid.Row="3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.DocumentFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8A5;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.HATestResource.GetString('DocumentInformation')}" />
                            </Grid>
                        </Expander.Header>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
