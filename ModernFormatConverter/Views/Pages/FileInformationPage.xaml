                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="15"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('AlternateGroup')}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="15"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind VideoDisplayAudioInfo.AlternateGroup, Mode=OneWay}"
                                            TextWrapping="Wrap" />

                                        <StackPanel
                                            Grid.Row="16"
                                            Grid.ColumnSpan="2"
                                            Margin="0,5,0,-4"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="3">

                                            <Button
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                Click="{x:Bind OnForwardVideoDisplayAudioInfoClicked}"
                                                CornerRadius="{StaticResource ControlCornerRadius}">

                                                <FontIcon FontSize="16" Glyph="&#xE76B;" />

                                                <ToolTipService.ToolTip>
                                                    <ToolTip
                                                        MaxWidth="9999"
                                                        Padding="0"
                                                        Background="Transparent">

                                                        <Grid>
                                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('ForwardDisplayAudioInfo')}" />
                                                        </Grid>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </Button>

                                            <NumberBox ValueChanged="{x:Bind OnVideoDisplayAudioInfoSelectedIndexValueChanged}" Value="{x:Bind VideoDisplayAudioInfoSelectedIndex, Mode=OneWay}">
                                                <NumberBox.Resources>
                                                    <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                                </NumberBox.Resources>
                                            </NumberBox>

                                            <TextBlock Margin="0,0,3,2" VerticalAlignment="Center">

                                                <Run Text="/" />
                                                <Run Text="{x:Bind VideoDisplayAudioInfoCount, Mode=OneWay}" />
                                            </TextBlock>

                                            <Button
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                Click="{x:Bind OnNextVideoDisplayAudioInfoClicked}"
                                                CornerRadius="{StaticResource ControlCornerRadius}">

                                                <FontIcon FontSize="16" Glyph="&#xE76C;" />

                                                <ToolTipService.ToolTip>
                                                    <ToolTip
                                                        MaxWidth="9999"
                                                        Padding="0"
                                                        Background="Transparent">

                                                        <Grid>
                                                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('NextDisplayAidioInfo')}" />
                                                        </Grid>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(VideoInformationSelectedItem, VideoInformationSelectorBar.Items[3]), Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>

                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(VideoInformationSelectedItem, VideoInformationSelectorBar.Items[4]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyVideoDisplayAllInfo')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsVideoDisplayAllInfoExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayAllInfo, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsVideoDisplayAllInfoExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--  音频信息  -->
                    <Expander
                        Grid.Row="2"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.AudioFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8D6;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('AudioInformation')}" />
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="AudioInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind AudioInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnAudioInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Audio')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1">
                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(AudioInformationSelectedItem, AudioInformationSelectorBar.Items[2]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyAudioAllInformation')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsAudioAllInformationExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind AudioInformation.AudioAllInformation, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsAudioAllInformationExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--  文档信息  -->
                    <Expander
                        Grid.Row="3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.TextFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8A5;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('TextInformation')}" />
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="TextInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind TextInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnTextInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Text')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1">
                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(TextInformationSelectedItem, TextInformationSelectorBar.Items[2]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyTextAllInformation')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsTextAllInformationExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind TextInformation.TextAllInformation, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsTextAllInformationExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--  图像信息  -->
                    <Expander
                        Grid.Row="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.ImageFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8B9;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('ImageInformation')}" />
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="ImageInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind ImageInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnImageInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Text')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1">
                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(ImageInformationSelectedItem, ImageInformationSelectorBar.Items[2]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyImageAllInformation')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageAllInformationExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ImageAllInformation, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsImageAllInformationExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>

        <TextBlock
            Grid.Row="4"
            Margin="0,3,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('MediaInfoSupport')}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
