<Page
    x:Class="ModernFormatConverter.Views.Pages.FileInformationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    AllowDrop="True"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="30,15,30,0"
            FontSize="22"
            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileInformation')}" />

        <!--  文件信息控制栏  -->
        <Grid
            Grid.Row="1"
            Height="60"
            Margin="30,5,30,3"
            Padding="18,0,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Margin="0,0,12,0"
                FontSize="16"
                Glyph="&#xE74C;" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Operation')}" />

            <CommandBar
                Grid.Column="2"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right">

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnOpenFileClicked}"
                        IsEnabled="{x:Bind GetIsParsing(FileInformationResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('OpenFile')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>
        </Grid>

        <!--  文件未解析信息栏  -->
        <Grid
            Grid.Row="2"
            Height="60"
            Margin="30,0,30,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind GetFileInformationSuccessfullyState(FileInformationResultKind, x:False), Mode=OneWay}">

            <Grid>
                <!--  未解析文件  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileNotParse')}"
                    TextAlignment="Center"
                    Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.NotParse), Mode=OneWay}" />

                <!--  正在加载中  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.Parsing), Mode=OneWay}">

                    <ProgressRing IsActive="True" IsEnabled="True" />

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('ParsingFileInformation')}"
                        TextAlignment="Center" />
                </StackPanel>

                <!--  解析文件失败  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Bind FileInformationFailedContent, Mode=OneWay}"
                    TextAlignment="Center"
                    Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.Failed), Mode=OneWay}" />
            </Grid>
        </Grid>

        <!--  文件详细信息  -->
        <Grid Grid.Row="3" Visibility="{x:Bind GetFileInformationSuccessfullyState(FileInformationResultKind, x:True), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Margin="40,0,10,0"
                VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="{x:Bind FileThumbnailImage, Mode=OneWay}" />

                <TextBlock
                    x:Name="FileNameText"
                    Grid.Row="1"
                    Margin="0,5,0,5"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Text="{x:Bind FileName, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis">

                    <ToolTipService.ToolTip>
                        <ToolTip
                            MaxWidth="9999"
                            Padding="0"
                            Background="Transparent"
                            Visibility="{x:Bind FileNameText.IsTextTrimmed, Mode=OneWay}">

                            <Grid>
                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind FileName, Mode=OneWay}" />
                            </Grid>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                </TextBlock>

                <Button
                    Grid.Row="2"
                    Margin="0,0,0,3"
                    HorizontalAlignment="Stretch"
                    Click="{x:Bind OnFilePropertiesClicked}"
                    Content="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileProperties')}" />

                <Button
                    Grid.Row="3"
                    Margin="0,0,0,3"
                    HorizontalAlignment="Stretch"
                    Click="{x:Bind OnOpenFileLocationClicked}"
                    Content="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileLocation')}" />
            </Grid>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Visible"
                VerticalScrollMode="Enabled">

                <Grid Margin="0,0,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                    </Grid.RowDefinitions>

                    <!--  基本信息  -->
                    <Expander
                        Grid.Row="0"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE946;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('GeneralInformation')}" />

                                <CommandBar
                                    Grid.Column="2"
                                    Margin="0,0,-15,0"
                                    DefaultLabelPosition="Right">

                                    <CommandBar.PrimaryCommands>
                                        <AppBarButton Click="{x:Bind OnGeneralInformationCopyClicked}" Label="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Copy')}">

                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                    </CommandBar.PrimaryCommands>
                                </CommandBar>
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,0,10,0" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileName')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileName, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileType')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileType, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileSize')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileSize, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileSpaceUsage')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileSpaceUsage, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileCreateTime')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileCreateTime, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileModifyTime')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileModifyTime, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileAccessTime')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileAccessTime, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Expander>

                    <!--  视频信息  -->
                    <Expander
                        Grid.Row="1"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.VideoFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE714;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('VideoInformation')}" />
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="VideoInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind VideoInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnVideoInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Video')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Audio')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Text')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1" Margin="0,0,10,0">
                                <Grid RowSpacing="3" Visibility="{x:Bind GetSelectedSelectorBarItem(VideoInformationSelectedItem, VideoInformationSelectorBar.Items[0]), Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('CompleteName')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.CompleteName, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Format')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.Format, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FormatVersion')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.FormatVersion, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FormatProfile')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.FormatProfile, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('CodecID')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.CodecID, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileSize')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.FileSize, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('UniqueID')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.UniqueID, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EncodedDate')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.EncodedDate, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="8"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Duration')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.Duration, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="9"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('OverallBitRate')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="9"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.OverallBitRate, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="10"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FrameRate')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="10"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.FrameRate, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="11"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('StreamSize')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="11"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.StreamSize, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="12"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('RecordedDate')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="12"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.RecordedDate, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="13"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EncodedApplication')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="13"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.EncodedApplication, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="14"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EncodedLibrary')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="14"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoDisplayGeneralInfo.EncodedLibrary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(VideoInformationSelectedItem, VideoInformationSelectorBar.Items[1]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyVideoDisplayVideoInfo')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(VideoDisplayVideoInfoCount), Mode=OneWay}" />

                                    <Grid RowSpacing="3" Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(VideoDisplayVideoInfoCount), Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('ID')}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind VideoDisplayVideoInfo.ID, Mode=OneWay}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Format')}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
