                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('CompressionMode')}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind TextDetailInfo.CompressionMode, Mode=OneWay}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('CountOfEvents')}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind TextDetailInfo.CountOfEvents, Mode=OneWay}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('MinimumDurationPerEvent')}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind TextDetailInfo.MinimumDurationPerEvent, Mode=OneWay}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="8"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('CountOfLines')}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="8"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind TextDetailInfo.CountOfLines, Mode=OneWay}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="9"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('MaximumCountOfLinesPerEvent')}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="9"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind TextDetailInfo.MaximumCountOfLinesPerEvent, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsTextDetailInfoExisted), Mode=OneWay}">

                                        <TextBlock
                                            Margin="0,5,0,3"
                                            HorizontalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyTextInfo')}" />
                                    </Grid>
                                </Grid>

                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(TextInformationSelectedItem, TextInformationSelectorBar.Items[1]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyTextInfo')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsTextOverviewInfoExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        FontFamily="Consolas"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind TextOverviewInfo, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsTextOverviewInfoExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--  图像信息  -->
                    <Expander
                        Grid.Row="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.ImageFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8B9;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('ImageInformation')}" />

                                <CommandBar
                                    Grid.Column="2"
                                    Margin="0,0,-15,0"
                                    DefaultLabelPosition="Right">

                                    <CommandBar.PrimaryCommands>
                                        <AppBarButton Click="{x:Bind OnImageInformationCopyClicked}" Label="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Copy')}">

                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                    </CommandBar.PrimaryCommands>
                                </CommandBar>
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="ImageInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind ImageInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnImageInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Image')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Exif')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1">
                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(ImageInformationSelectedItem, ImageInformationSelectorBar.Items[3]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyImageInfo')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageOverviewInformationExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        FontFamily="Consolas"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ImageOverviewInformation, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsImageOverviewInformationExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
