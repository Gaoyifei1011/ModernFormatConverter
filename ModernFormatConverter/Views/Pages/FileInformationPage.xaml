<Page
    x:Class="ModernFormatConverter.Views.Pages.FileInformationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    AllowDrop="True"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="30,15,30,0"
            FontSize="22"
            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileInformation')}" />

        <!--  文件信息控制栏  -->
        <Grid
            Grid.Row="1"
            Height="60"
            Margin="30,5,30,3"
            Padding="18,0,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Margin="0,0,12,0"
                FontSize="16"
                Glyph="&#xE74C;" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Operation')}" />

            <CommandBar
                Grid.Column="2"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right">

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnOpenFileClicked}"
                        IsEnabled="{x:Bind GetIsParsing(FileInformationResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('OpenFile')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>
        </Grid>

        <!--  文件未解析信息栏  -->
        <Grid
            Grid.Row="2"
            Height="60"
            Margin="30,0,30,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind GetFileInformationSuccessfullyState(FileInformationResultKind, x:False), Mode=OneWay}">

            <Grid>
                <!--  未解析文件  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileNotParse')}"
                    TextAlignment="Center"
                    Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.NotParse), Mode=OneWay}" />

                <!--  正在加载中  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.Parsing), Mode=OneWay}">

                    <ProgressRing IsActive="True" IsEnabled="True" />

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('ParsingFileInformation')}"
                        TextAlignment="Center" />
                </StackPanel>

                <!--  解析文件失败  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Bind FileInformationFailedContent, Mode=OneWay}"
                    TextAlignment="Center"
                    Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.Failed), Mode=OneWay}" />
            </Grid>
        </Grid>

        <!--  文件详细信息  -->
        <Grid Grid.Row="3" Visibility="{x:Bind GetFileInformationSuccessfullyState(FileInformationResultKind, x:True), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Margin="40,0,10,0"
                VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="{x:Bind FileThumbnailImage, Mode=OneWay}" />

                <TextBlock
                    x:Name="FileNameText"
                    Grid.Row="1"
                    Margin="0,5,0,5"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Text="{x:Bind FileName, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis">

                    <ToolTipService.ToolTip>
                        <ToolTip
                            MaxWidth="9999"
                            Padding="0"
                            Background="Transparent"
                            Visibility="{x:Bind FileNameText.IsTextTrimmed, Mode=OneWay}">

                            <Grid>
                                <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                                <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind FileName, Mode=OneWay}" />
                            </Grid>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                </TextBlock>

                <Button
                    Grid.Row="2"
                    Margin="0,0,0,3"
                    HorizontalAlignment="Stretch"
                    Click="{x:Bind OnFilePropertiesClicked}"
                    Content="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileProperties')}" />

                <Button
                    Grid.Row="3"
                    Margin="0,0,0,3"
                    HorizontalAlignment="Stretch"
                    Click="{x:Bind OnOpenFileLocationClicked}"
                    Content="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileLocation')}" />
            </Grid>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Visible"
                VerticalScrollMode="Enabled">

                <Grid Margin="0,0,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                        <RowDefinition Height="Auto " />
                    </Grid.RowDefinitions>

                    <!--  基本信息  -->
                    <Expander
                        Grid.Row="0"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE946;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('GeneralInformation')}" />

                                <CommandBar
                                    Grid.Column="2"
                                    Margin="0,0,-15,0"
                                    DefaultLabelPosition="Right">

                                    <CommandBar.PrimaryCommands>
                                        <AppBarButton Click="{x:Bind OnGeneralInformationCopyClicked}" Label="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Copy')}">

                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                    </CommandBar.PrimaryCommands>
                                </CommandBar>
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,0,10,0" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileName')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileName, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileType')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileType, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileSize')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileSize, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileSpaceUsage')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileSpaceUsage, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileCreateTime')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileCreateTime, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileModifyTime')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileModifyTime, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('FileAccessTime')}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind FileAccessTime, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Expander>

                    <!--  视频信息  -->
                    <Expander
                        Grid.Row="1"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.VideoFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE714;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('VideoInformation')}" />
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="VideoInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind VideoInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnVideoInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Video')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Audio')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Text')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1">
                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(VideoInformationSelectedItem, VideoInformationSelectorBar.Items[4]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyVideoAllInformation')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsVideoAllInformationExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind VideoAllInformation, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsVideoAllInformationExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--  音频信息  -->
                    <Expander
                        Grid.Row="2"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.AudioFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8D6;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('AudioInformation')}" />
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="AudioInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind AudioInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnAudioInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Audio')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1">
                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(AudioInformationSelectedItem, AudioInformationSelectorBar.Items[2]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyAudioAllInformation')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsAudioAllInformationExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind AudioAllInformation, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsAudioAllInformationExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--  文档信息  -->
                    <Expander
                        Grid.Row="3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.TextFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8A5;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('TextInformation')}" />
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="TextInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind TextInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnTextInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Text')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1">
                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(TextInformationSelectedItem, TextInformationSelectorBar.Items[2]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyTextAllInformation')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsTextAllInformationExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind TextAllInformation, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsTextAllInformationExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--  图像信息  -->
                    <Expander
                        Grid.Row="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True"
                        Visibility="{x:Bind CheckFileInformationState(FileInformationResultKind, enum:FileInformationResultKind.ImageFile), Mode=OneWay}">

                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE8B9;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('ImageInformation')}" />
                            </Grid>
                        </Expander.Header>

                        <Grid Margin="0,-8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="ImageInformationSelectorBar"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                SelectedItem="{x:Bind ImageInformationSelectedItem, Mode=OneWay}"
                                SelectionChanged="{x:Bind OnImageInformationSelectorBarSelectionChanged}">

                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Basic')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Text')}" />
                                <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('Overview')}" />
                            </SelectorBar>

                            <Grid Grid.Row="1">
                                <Grid Visibility="{x:Bind GetSelectedSelectorBarItem(ImageInformationSelectedItem, ImageInformationSelectorBar.Items[2]), Mode=OneWay}">

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('EmptyImageAllInformation')}"
                                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsImageAllInformationExisted), Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,5,0,3"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ImageAllInformation, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsImageAllInformationExisted, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>

        <TextBlock
            Grid.Row="4"
            Margin="0,3,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind rootservice:ResourceService.FileInformationResource.GetString('MediaInfoSupport')}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
