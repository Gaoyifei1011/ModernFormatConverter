<Page
    x:Class="ModernFormatConverter.Views.Pages.AudioEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:enum="using:ModernFormatConverter.Extensions.DataType.Enums"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="16,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="320" />
            </Grid.RowDefinitions>

            <ProgressRing
                Grid.Row="0"
                Width="80"
                Height="80"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind x:Object.Equals(AudioEditResultKind, enum:AudioEditResultKind.Loading), Mode=OneWay}"
                Visibility="{x:Bind GetAudioEditKind(AudioEditResultKind, enum:AudioEditResultKind.Loading), Mode=OneWay}" />

            <!--  音频播放组件  -->
            <MediaPlayerElement
                x:Name="AudioEditMediaPlayerElement"
                Grid.Row="0"
                AreTransportControlsEnabled="True"
                AutoPlay="False"
                Source="{x:Bind MediaSource, Mode=OneWay}"
                Visibility="{x:Bind GetAudioEditKind(AudioEditResultKind, enum:AudioEditResultKind.Successfully), Mode=OneWay}">

                <MediaPlayerElement.TransportControls>
                    <MediaTransportControls
                        IsCompact="False"
                        IsFastForwardButtonVisible="True"
                        IsFastForwardEnabled="True"
                        IsFastRewindButtonVisible="True"
                        IsFastRewindEnabled="True"
                        IsPlaybackRateButtonVisible="True"
                        IsPlaybackRateEnabled="True"
                        IsSeekBarVisible="True"
                        IsSeekEnabled="True"
                        IsSkipBackwardButtonVisible="True"
                        IsSkipBackwardEnabled="True"
                        IsSkipForwardButtonVisible="True"
                        IsSkipForwardEnabled="True"
                        IsStopButtonVisible="True"
                        IsStopEnabled="True"
                        IsVolumeButtonVisible="True"
                        IsVolumeEnabled="True"
                        IsZoomButtonVisible="True"
                        IsZoomEnabled="True"
                        Style="{StaticResource MediaTransportControlsStyle}"
                        Visibility="Visible" />
                </MediaPlayerElement.TransportControls>
            </MediaPlayerElement>

            <Image
                Grid.Row="0"
                Width="200"
                Height="200"
                Margin="0,0,0,112"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="{x:Bind AudioCoverImage, Mode=OneWay}"
                Visibility="{x:Bind GetAudioEditKind(AudioEditResultKind, enum:AudioEditResultKind.Successfully), Mode=OneWay}" />

            <!--  音频播放失败  -->
            <Grid
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RowSpacing="10"
                Visibility="{x:Bind GetAudioEditKind(AudioEditResultKind, enum:AudioEditResultKind.Failed), Mode=OneWay}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="50,0,50,0"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('AudioPlayFailed')}"
                    TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" HorizontalAlignment="Center">
                    <Run Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('ErrorReason')}" />
                    <Run Text="{x:Bind ErrorReason, Mode=OneWay}" />
                </TextBlock>

                <Button
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Click="{x:Bind OnPlayWithSystemAudioClicked}"
                    Content="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('PlayWithSystemAudio')}" />
            </Grid>

            <!--  剪切音频选项  -->
            <Grid
                Grid.Row="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="FileNameText"
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Bind FileName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">

                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="9999"
                                Padding="0"
                                Background="Transparent"
                                Content="{x:Bind FileName, Mode=OneWay}"
                                Visibility="{x:Bind FileNameText.IsTextTrimmed, Mode=OneWay}" />
                        </ToolTipService.ToolTip>
                    </TextBlock>

                    <SelectorBar
                        x:Name="AudioEditSelectorBar"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        SelectedItem="{x:Bind AudioEditSelectedItem, Mode=OneWay}"
                        SelectionChanged="{x:Bind OnAudioEditSelectionChanged}">

                        <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('Editing')}" />
                        <SelectorBarItem Padding="12,5" Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('Cover')}" />
                    </SelectorBar>

                    <Button
                        Grid.Column="2"
                        Width="30"
                        Height="30"
                        Margin="0,0,10,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="{x:Bind OnOkClicked}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('OK')}">

                        <FontIcon FontSize="14" Glyph="&#xE8FB;" />
                    </Button>
                </Grid>

                <!--  编辑选项  -->
                <Grid
                    Grid.Row="1"
                    Margin="10,5,10,10"
                    Visibility="{x:Bind GetAudioEditSelectedItem(AudioEditSelectedItem, AudioEditSelectorBar.Items[0]), Mode=OneWay}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  起始时间选项  -->
                    <Grid Grid.Column="0" RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            FontSize="20"
                            Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('StartTime')}" />

                        <ContentControl Grid.Row="1" HorizontalAlignment="Left">

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('Hours')}" />

                                <NumberBox
                                    VerticalAlignment="Center"
                                    LargeChange="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Style="{StaticResource NumberBoxStyle}"
                                    ValueChanged="{x:Bind OnTimeStartHoursValueChanged}"
                                    Value="{x:Bind TimeStartHours, Mode=OneWay}" />

                                <TextBlock
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('Minutes')}" />

                                <NumberBox
                                    VerticalAlignment="Center"
                                    LargeChange="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Style="{StaticResource NumberBoxStyle}"
                                    ValueChanged="{x:Bind OnTimeStartMinutesValueChanged}"
                                    Value="{x:Bind TimeStartMinutes, Mode=OneWay}" />

                                <TextBlock
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('Seconds')}" />

                                <NumberBox
                                    VerticalAlignment="Center"
                                    LargeChange="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Style="{StaticResource NumberBoxStyle}"
                                    ValueChanged="{x:Bind OnTimeStartSecondsValueChanged}"
                                    Value="{x:Bind TimeStartSeconds, Mode=OneWay}" />

                                <NumberBox
                                    VerticalAlignment="Center"
                                    LargeChange="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Style="{StaticResource NumberBoxStyle}"
                                    ValueChanged="{x:Bind OnTimeStartMillsecondsValueChanged}"
                                    Value="{x:Bind TimeStartMillseconds, Mode=OneWay}" />

                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnTimeStartLocationClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('TimeStartLocation')}">

                                    <FontIcon FontSize="16" Glyph="&#xECAF;" />
                                </Button>

                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="{x:Bind OnTimeStartLocateVdieoClicked}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('LocateAudio')}">

                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                </Button>
                            </StackPanel>
                        </ContentControl>
                    </Grid>

                    <AppBarSeparator Grid.Column="1" Margin="15,-8,15,-30" />

                    <!--  结束时间选项  -->
                    <Grid Grid.Column="2" RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            FontSize="20"
                            Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('EndTime')}" />

                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="5">

                            <TextBlock
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('Hours')}" />

                            <NumberBox
                                VerticalAlignment="Center"
                                LargeChange="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Style="{StaticResource NumberBoxStyle}"
                                ValueChanged="{x:Bind OnTimeEndHoursValueChanged}"
                                Value="{x:Bind TimeEndHours, Mode=OneWay}" />

                            <TextBlock
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('Minutes')}" />

                            <NumberBox
                                VerticalAlignment="Center"
                                LargeChange="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Style="{StaticResource NumberBoxStyle}"
                                ValueChanged="{x:Bind OnTimeEndMinutesValueChanged}"
                                Value="{x:Bind TimeEndMinutes, Mode=OneWay}" />

                            <TextBlock
                                Margin="0,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('Seconds')}" />

                            <NumberBox
                                VerticalAlignment="Center"
                                LargeChange="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Style="{StaticResource NumberBoxStyle}"
                                ValueChanged="{x:Bind OnTimeEndSecondsValueChanged}"
                                Value="{x:Bind TimeEndSeconds, Mode=OneWay}" />

                            <NumberBox
                                VerticalAlignment="Center"
                                LargeChange="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Style="{StaticResource NumberBoxStyle}"
                                ValueChanged="{x:Bind OnTimeEndMillsecondsValueChanged}"
                                Value="{x:Bind TimeEndMillseconds, Mode=OneWay}" />

                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="{x:Bind OnTimeEndLocationClicked}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('TimeEndLocation')}">

                                <FontIcon FontSize="16" Glyph="&#xECAF;" />
                            </Button>

                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="{x:Bind OnTimeEndLocateVdieoClicked}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('LocateAudio')}">

                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!--  封面选项  -->
                <Grid
                    Grid.Row="1"
                    Margin="10,5,10,10"
                    RowSpacing="5"
                    Visibility="{x:Bind GetAudioEditSelectedItem(AudioEditSelectedItem, AudioEditSelectorBar.Items[1]), Mode=OneWay}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('SetAudioCover')}" />

                        <Button
                            Width="32"
                            Height="32"
                            Margin="0,0,5,0"
                            Padding="0"
                            Click="{x:Bind OnSelectFileClicked}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsLoadingAudioCover), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('SelectFile')}">

                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                        </Button>

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Click="{x:Bind OnClearSelectFileClicked}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsLoadingAudioCover), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('ClearSelectFile')}">

                            <FontIcon FontSize="16" Glyph="&#xE894;" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock
                            Text="{x:Bind rootservice:ResourceService.AudioEditResource.GetString('AudioCoverPositon')}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <TextBlock Visibility="{x:Bind GetAudioConverFilePathState(AudioCoverFilePath, x:False), Mode=OneWay}">
                            <Hyperlink Click="{x:Bind OnAudioCoverFilePathClicked}" UnderlineStyle="None">
                                <Run Text="{x:Bind AudioCoverFilePath, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Text="N/A" Visibility="{x:Bind GetAudioConverFilePathState(AudioCoverFilePath, x:True), Mode=OneWay}" />
                    </StackPanel>

                    <Grid
                        Grid.Row="2"
                        Width="400"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}">

                        <ProgressRing
                            Width="45"
                            Height="45"
                            Canvas.ZIndex="1"
                            IsActive="{x:Bind IsLoadingAudioCover, Mode=OneWay}"
                            Visibility="{x:Bind IsLoadingAudioCover, Mode=OneWay}" />

                        <Image Source="{x:Bind SelectedAudioCoverImage, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
