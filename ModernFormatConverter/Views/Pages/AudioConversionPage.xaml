<Page
    x:Class="ModernFormatConverter.Views.Pages.AudioConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:collection="using:System.Collections"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
            <Thickness x:Key="BreadcrumbBarChevronPadding">8,0</Thickness>

            <TransitionCollection x:Name="SuppressNavigationTransitionCollection">
                <NavigationThemeTransition>
                    <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        <SuppressNavigationTransitionInfo />
                    </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                </NavigationThemeTransition>
            </TransitionCollection>

            <TransitionCollection x:Name="LeftSlideNavigationTransitionCollection">
                <NavigationThemeTransition>
                    <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        <SlideNavigationTransitionInfo Effect="FromLeft" />
                    </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                </NavigationThemeTransition>
            </TransitionCollection>

            <TransitionCollection x:Name="RightSlideNavigationTransitionCollection">
                <NavigationThemeTransition>
                    <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        <SlideNavigationTransitionInfo Effect="FromRight" />
                    </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                </NavigationThemeTransition>
            </TransitionCollection>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="40"
                Height="36"
                VerticalAlignment="Center"
                Background="{ThemeResource TitleBarBackButtonBackground}"
                Click="{x:Bind OnBackClicked}"
                IsEnabled="{x:Bind IsBackEnabled, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">

                <AnimatedIcon
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AnimatedIcon.State="Normal">
                    <animatedvisuals:AnimatedBackVisualSource />
                    <AnimatedIcon.FallbackIconSource>
                        <FontIconSource
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            MirroredWhenRightToLeft="True" />
                    </AnimatedIcon.FallbackIconSource>
                </AnimatedIcon>

                <ToolTipService.ToolTip>
                    <ToolTip
                        MaxWidth="9999"
                        Padding="0"
                        Background="Transparent">

                        <Grid>
                            <SystemBackdropElement CornerRadius="{StaticResource ControlCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />
                            <TextBlock Padding="{StaticResource ToolTipBorderPadding}" Text="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('Back')}" />
                        </Grid>
                    </ToolTip>
                </ToolTipService.ToolTip>
            </Button>

            <BreadcrumbBar
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemClicked="{x:Bind OnItemClicked}"
                ItemsSource="{x:Bind BreadCollection}">

                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="collection:DictionaryEntry">
                        <TextBlock FontSize="22" Text="{x:Bind (x:String)Value}" />
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
        </Grid>

        <Frame
            x:Name="AudioConversionFrame"
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Navigated="{x:Bind OnNavigated}"
            NavigationFailed="{x:Bind OnNavigationFailed}" />

        <Grid
            Grid.Row="2"
            Padding="{ThemeResource ContentDialogPadding}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                MinWidth="100"
                HorizontalAlignment="Stretch"
                Click="{x:Bind OnNextStepClicked}"
                Content="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('NextStep')}"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="{x:Bind GetSelectedStep(BreadCollection.Count, 1), Mode=OneWay}" />

            <Button
                Grid.Column="1"
                MinWidth="100"
                HorizontalAlignment="Stretch"
                Click="{x:Bind OnOkClicked}"
                Content="{x:Bind rootservice:ResourceService.AudioConversionResource.GetString('OK')}"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="{x:Bind GetSelectedStep(BreadCollection.Count, 2), Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
