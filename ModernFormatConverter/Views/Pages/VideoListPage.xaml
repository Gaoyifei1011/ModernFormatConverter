                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!--  视频导出图片控件  -->
                <Grid x:Name="VideoExportPictureGrid" x:Load="{x:Bind x:Object.Equals(SelectedConversionType.VideoConversionTypeKind, enum:VideoConversionTypeKind.VideoExportPicture), Mode=OneWay}">

                    <!--  添加文件信息提示和按钮  -->
                    <Grid
                        Margin="0,0,30,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(VideoConversionTypeCollection[4].VideoExportPicture.VideoExportPictureFileCollection.Count), Mode=OneWay}">

                        <Grid
                            Margin="30"
                            Canvas.ZIndex="1"
                            RowSpacing="15">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.VideoListResource.GetString('DragAddFileTip')}" />

                            <Button
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="{x:Bind OnAddFileClicked}"
                                Content="{x:Bind rootservice:ResourceService.VideoListResource.GetString('AddFile')}" />
                        </Grid>

                        <Rectangle
                            Canvas.ZIndex="0"
                            Fill="Transparent"
                            RadiusX="4"
                            RadiusY="4"
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeDashArray="5,2"
                            StrokeThickness="1" />
                    </Grid>

                    <!--  视频导出图片文件信息列表  -->
                    <ListView
                        Padding="0,0,26,30"
                        ItemsSource="{x:Bind VideoConversionTypeCollection[4].VideoExportPicture.VideoExportPictureFileCollection, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        SelectionMode="None"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(VideoConversionTypeCollection[4].VideoExportPicture.VideoExportPictureFileCollection.Count), Mode=OneWay}">

                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:VideoExportPictureFileModel">
                                <Grid
                                    Height="100"
                                    Margin="0,0,3,3"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Grid.Column="0"
                                        Width="120"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,1,0">

                                        <Image Grid.Column="0" Source="{x:Bind FileThumbnailSource, Mode=OneWay}" />
                                    </Grid>

                                    <Grid
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        RowSpacing="5">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind FileName}"
                                            TextLineBounds="TrimToCapHeight"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{x:Bind FilePath}" Visibility="{Binding ElementName=DescriptionText, Path=IsTextTrimmed, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis">

                                            <Run Text="{x:Bind FileSize, Converter={StaticResource FileSizeValueConverter}}" />
                                            <Run Text=" | " />
                                            <Run Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}" />
                                            <Run Text=" | " />
                                            <Run Text="{x:Bind ScreenSizeWidth}" /><Run Text="x" /><Run Text="{x:Bind ScreenSizeHeight}" />
                                        </TextBlock>
                                    </Grid>

                                    <Grid Grid.Column="2" Margin="5,0,20,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Padding="7"
                                            Command="{StaticResource OutputConfigurationCommand}"
                                            CommandParameter="{x:Bind}"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.VideoListResource.GetString('OutputConfiguration')}">

                                            <AnimatedIcon>
                                                <AnimatedIcon.Source>
                                                    <animatedvisuals:AnimatedSettingsVisualSource />
                                                </AnimatedIcon.Source>
                                                <AnimatedIcon.FallbackIconSource>
                                                    <FontIconSource Glyph="&#xE713;" />
                                                </AnimatedIcon.FallbackIconSource>
                                            </AnimatedIcon>
                                        </Button>

                                        <Button
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Margin="5,0,0,0"
                                            Padding="0"
                                            Command="{StaticResource RemoveCommand}"
                                            CommandParameter="{x:Bind}"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.VideoListResource.GetString('Remove')}">

                                            <FontIcon FontSize="16" Glyph="&#xE894;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
