<Page
    x:Class="ModernFormatConverter.Views.Pages.CustomCommandPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:backdrophelper="using:ModernFormatConverter.Helpers.Backdrop"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ModernFormatConverter.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="30,15,30,0"
            FontSize="22"
            Text="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('CustomCommand')}" />

        <!--  右键菜单管理控制栏  -->
        <Grid
            Grid.Row="1"
            Height="60"
            Margin="30,5,30,3"
            Padding="12,0,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                Margin="0,0,2,0"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsRunning), Mode=OneWay}"
                PlaceholderText="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('CommandPHText')}"
                QuerySubmitted="{x:Bind OnQuerySubmitted}"
                Text="{x:Bind CommandText, Mode=OneWay}"
                TextChanged="{x:Bind OnTextChanged}" />

            <CommandBar
                Grid.Column="1"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right">

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnRunClicked}"
                        Label="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('Run')}"
                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsRunning), Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnStopClicked}"
                        Label="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('Stop')}"
                        Visibility="{x:Bind IsRunning, Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71A;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="30,0,30,3"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <TextBox
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                Style="{StaticResource CustomCommandResultTextBoxStyle}"
                Text="{x:Bind CommandResultText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="3" Margin="30,0,30,40">
            <TextBlock Text="Test Description" />
        </Grid>
    </Grid>
</Page>
