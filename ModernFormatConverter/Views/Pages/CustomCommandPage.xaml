<Page
    x:Class="ModernFormatConverter.Views.Pages.CustomCommandPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:backdrophelper="using:ModernFormatConverter.Helpers.Backdrop"
    xmlns:converter="using:ModernFormatConverter.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ModernFormatConverter.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rootservice="using:ModernFormatConverter.Services.Root"
    Loaded="{x:Bind OnLoaded}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="30,15,30,0"
            FontSize="22"
            Text="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('CustomCommand')}" />

        <!--  右键菜单管理控制栏  -->
        <Grid
            Grid.Row="1"
            Height="60"
            Margin="30,5,30,3"
            Padding="12,0,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                Margin="0,0,2,0"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsRunning), Mode=OneWay}"
                PlaceholderText="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('CommandPHText')}"
                QuerySubmitted="{x:Bind OnQuerySubmitted}"
                Text="{x:Bind CommandText, Mode=OneWay}"
                TextChanged="{x:Bind OnTextChanged}" />

            <CommandBar
                Grid.Column="1"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right">

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnRunClicked}"
                        Label="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('Run')}"
                        Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsRunning), Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnStopClicked}"
                        Label="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('Stop')}"
                        Visibility="{x:Bind IsRunning, Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71A;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>

            <Button
                Grid.Column="2"
                MinHeight="{ThemeResource AppBarThemeCompactHeight}"
                Margin="-6,0,0,0"
                Padding="{ThemeResource CommandBarMoreButtonMargin}"
                VerticalAlignment="Center"
                Foreground="{ThemeResource CommandBarForeground}"
                IsAccessKeyScope="True"
                Style="{ThemeResource EllipsisButton}">

                <Button.Content>
                    <FontIcon
                        Height="{ThemeResource AppBarExpandButtonCircleDiameter}"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Glyph="&#xE712;" />
                </Button.Content>

                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem
                            Click="{x:Bind OnTestClicked}"
                            IsEnabled="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsRunning), Mode=OneWay}"
                            Text="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('Test')}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE756;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem Click="{x:Bind OnClearResultClicked}" Text="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('ClearResult')}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>

                <ToolTipService.ToolTip>
                    <ToolTip
                        MaxWidth="9999"
                        Content="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('ViewMore')}"
                        Loaded="{x:Bind backdrophelper:ToolTipBackdropHelper.OnLoaded}" />
                </ToolTipService.ToolTip>
            </Button>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="30,0,30,3"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <TextBox
                x:Name="CommandResultTextBox"
                Padding="16,5,20,6"
                FontSize="15"
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                Style="{StaticResource CustomCommandResultTextBoxStyle}"
                Text="{x:Bind CommandResultText, Mode=OneWay}"
                TextAlignment="Justify"
                TextChanged="{x:Bind OnCommandResultTextChanged}"
                TextWrapping="Wrap" />
        </Grid>

        <!--  小提示  -->
        <Expander
            Grid.Row="3"
            Margin="30,0,30,30"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            IsExpanded="True">

            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        FontSize="16"
                        Glyph="&#xE82F;" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('Tips')}" />
                </Grid>
            </Expander.Header>

            <Expander.Content>
                <StackPanel>
                    <TextBlock
                        Margin="44,10,16,5"
                        FontSize="14"
                        FontWeight="Normal"
                        Text="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('TipContent1')}"
                        TextAlignment="Justify"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="44,0,16,5"
                        FontSize="14"
                        FontWeight="Normal"
                        Text="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('TipContent2')}"
                        TextAlignment="Justify"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="44,0,16,10"
                        FontSize="14"
                        FontWeight="Normal"
                        Text="{x:Bind rootservice:ResourceService.CustomCommandResource.GetString('TipContent3')}"
                        TextAlignment="Justify"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander.Content>
        </Expander>
    </Grid>
</Page>
